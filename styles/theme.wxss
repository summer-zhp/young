/* =====================================
   打工人治愈所 - 全局设计系统
   Theme: Healing Zen (治愈禅意)
   ===================================== */

/* ===== 颜色系统 ===== */
Page {
  /* 主色调 - 青绿渐变 */
  --primary-start: #8EC5B9;
  --primary-end: #6FA99A;
  --primary-dark: #5A9284;
  --primary-light: #A8D5CC;

  /* 辅助色 */
  --accent-pink: #FFB5A9;
  --accent-pink-light: #FFE4E1;
  --accent-coral: #FF6B81;

  /* 中性色 */
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --text-disabled: #BBBBBB;

  /* 背景色 */
  --bg-gradient-start: #F8F9FA;
  --bg-gradient-end: #E8F5F3;
  --surface-white: #FFFFFF;
  --surface-hover: #F5F5F5;

  /* 边框色 */
  --border-light: #E8E8E8;
  --border-normal: #D0D0D0;

  /* 功能色 */
  --success: #4CAF50;
  --warning: #FF9800;
  --error: #F44336;

  /* 焦点色 */
  --focus-ring: rgba(142, 197, 185, 0.4);
}

/* ===== 阴影系统 ===== */
Page {
  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.1);
  --shadow-xl: 0 12px 48px rgba(0, 0, 0, 0.12);

  /* 主题阴影 */
  --shadow-primary: 0 4px 20px rgba(142, 197, 185, 0.4);
  --shadow-primary-hover: 0 6px 24px rgba(142, 197, 185, 0.5);
}

/* ===== 圆角系统 ===== */
Page {
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 24rpx;
  --radius-2xl: 32rpx;
  --radius-full: 9999rpx;
}

/* ===== 间距系统 (基于 8rpx) ===== */
Page {
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
}

/* ===== 字体系统 ===== */
Page {
  --font-size-xs: 22rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-2xl: 40rpx;
  --font-size-3xl: 48rpx;

  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  --line-height-tight: 1.3;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.75;
}

/* ===== 动画系统 ===== */
Page {
  --transition-fast: 150ms ease;
  --transition-base: 200ms ease;
  --transition-slow: 300ms ease;
  --transition-bounce: 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ===== 通用工具类 ===== */

/* 清除按钮默认样式 */
button::after {
  border: none;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: calc(0rpx + env(safe-area-inset-bottom));
}

/* 渐变背景 */
.page-bg {
  background: linear-gradient(180deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
}

/* 卡片基础样式 */
.card-base {
  background: var(--surface-white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
}

/* 按钮基础样式 */
.btn-base {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-weight: var(--font-weight-semibold);
  transition: all var(--transition-base);
}

.btn-base:active {
  transform: scale(0.96);
}

/* 主题按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  color: var(--surface-white);
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  box-shadow: var(--shadow-primary-hover);
}

/* 次级按钮 */
.btn-secondary {
  background: var(--surface-hover);
  color: var(--text-secondary);
}

.btn-secondary:active {
  background: var(--border-light);
}

/* 幽灵按钮 */
.btn-ghost {
  background: transparent;
  color: var(--primary-start);
  border: 1px solid var(--primary-start);
}

/* 文本层级 */
.text-primary {
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

/* 弹性布局 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 隐藏滚动条但保留功能 */
.hide-scrollbar::-webkit-scrollbar {
  display: none;
}
