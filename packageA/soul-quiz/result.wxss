/* packageA/soul-quiz/result.wxss */
@import '../../styles/theme.wxss';

.result-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f0ef 100%);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== MBTI类型展示 ===== */
.type-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 40rpx 40rpx;
}

.type-animal-img {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 20rpx;
}

.type-name {
  font-size: 72rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
  -webkit-background-clip: text;
  color: transparent;
  letter-spacing: 8rpx;
}

.type-animal {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  font-weight: 500;
}

/* ===== 雷达图 ===== */
.radar-section {
  margin: 0 32rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: block;
}

.radar-container {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.radar-canvas {
  width: 300px;
  height: 300px;
}

.dimension-labels {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 0;
}

.dim-pair {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.dim-left, .dim-right {
  font-size: 24rpx;
  color: var(--text-disabled);
}

.dim-active {
  color: var(--primary-start);
  font-weight: 600;
}

/* ===== 三重标签 ===== */
.triple-section {
  margin: 0 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.triple-card {
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.triple-animal {
  background: linear-gradient(135deg, #E6F4F1 0%, #D4EDE8 100%);
}

.triple-work {
  background: linear-gradient(135deg, #FFF3E6 0%, #FFE8CC 100%);
}

.triple-fantasy {
  background: linear-gradient(135deg, #EDE6F5 0%, #DDD0ED 100%);
}

.triple-animal-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 12rpx;
}

.triple-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.triple-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.triple-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

/* ===== 性格解读 ===== */
.analysis-section {
  margin: 0 32rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.keywords-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.keyword-tag {
  font-size: 24rpx;
  color: var(--primary-start);
  background: rgba(142, 197, 185, 0.12);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.analysis-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* ===== 底部按钮 ===== */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-share {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
  color: #fff;
  padding: 24rpx 0;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-share:active {
  opacity: 0.9;
}

.btn-history, .btn-retry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.btn-text-secondary {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ===== 海报 Canvas（隐藏） ===== */
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
}

/* ===== 海报预览遮罩 ===== */
.poster-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.poster-image {
  width: 600rpx;
  border-radius: 24rpx;
}

.poster-actions {
  display: flex;
  gap: 24rpx;
}

.poster-btn {
  padding: 20rpx 56rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.save-btn {
  background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
  color: #fff;
}

.close-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}
