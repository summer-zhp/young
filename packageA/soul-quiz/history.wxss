/* packageA/soul-quiz/history.wxss */
@import '../../styles/theme.wxss';

.history-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f0ef 100%);
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-tertiary);
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 64rpx;
  background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
}

.empty-btn:active {
  opacity: 0.9;
}

/* ===== 历史列表 ===== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.history-card:active {
  background: #FAFAFA;
}

.card-img {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-type {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary-start);
}

.card-animal {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.card-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-tag {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.card-sep {
  font-size: 24rpx;
  color: var(--text-disabled);
}

.card-date {
  font-size: 22rpx;
  color: var(--text-disabled);
}

/* ===== 加载更多 ===== */
.load-more {
  padding: 32rpx;
  text-align: center;
}

.load-text {
  font-size: 26rpx;
  color: var(--primary-start);
}

/* ===== 加载中 ===== */
.loading-state {
  padding: 40rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* ===== 详情弹窗 ===== */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.detail-card {
  width: 100%;
  background: #fff;
  border-radius: 36rpx;
  overflow: hidden;
  animation: detailIn 0.3s ease-out;
}

@keyframes detailIn {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.detail-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
}

.detail-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 16rpx;
}

.detail-type {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--primary-start);
  letter-spacing: 4rpx;
}

.detail-animal {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  font-weight: 500;
}

.detail-body {
  padding: 32rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.detail-label {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.detail-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.detail-divider {
  height: 1rpx;
  background: var(--border-light);
}

.detail-close {
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  color: var(--primary-start);
  font-weight: 600;
  border-top: 1rpx solid var(--border-light);
}

.detail-close:active {
  background: #FAFAFA;
}
