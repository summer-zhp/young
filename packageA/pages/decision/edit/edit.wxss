/* pages/decision/edit/edit.wxss - 编辑转盘 */
@import '../../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: #f5f7fa;
  position: relative;
  overflow: hidden;
}

/* ===== 自定义导航栏 ===== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88px;
  padding-top: var(--status-bar-height, 20px);
  background-color: #8EC5B9;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  padding-bottom: 0;
}

.navbar-inner {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.navbar-back {
  position: absolute;
  left: 16rpx;
  display: flex;
  align-items: center;
  padding: 8rpx;
  z-index: 10;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* ===== 滚动内容区 ===== */
.content-scroll {
  height: 100vh;
  padding-top: 88px;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== 名称输入区域 ===== */
.input-section {
  padding: 32rpx 32rpx 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.title-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background-color: #8EC5B9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-title text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.name-input {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* ===== 选项列表区域 ===== */
.options-section {
  padding: 0 32rpx 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.add-option-wrapper {
  margin-top: 20rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background-color: #8EC5B9;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(142, 197, 185, 0.35);
}

.add-btn text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.option-item.empty {
  border-color: rgba(255, 160, 0, 0.3);
  background: rgba(255, 160, 0, 0.02);
}

.option-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background-color: #8EC5B9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  flex-shrink: 0;
}

.option-input {
  flex: 1;
  height: 56rpx;
  font-size: 30rpx;
  color: #1a1a2e;
}

.option-input::placeholder {
  color: #ccc;
}

.option-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.option-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f5f7fa;
  transition: all 0.2s ease;
}

.option-btn:active {
  background: #e8ecf1;
}

.option-btn.delete:active {
  background: rgba(245, 87, 108, 0.15);
}

.empty-options {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 0;
}

.empty-hint {
  font-size: 28rpx;
  color: #999;
}

.warning-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 160, 0, 0.1);
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.warning-hint text {
  font-size: 26rpx;
  color: #ffa000;
}

/* ===== 预览区域 ===== */
.preview-section {
  padding: 0 32rpx 24rpx;
}

.preview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.preview-tag {
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* ===== 底部保存按钮 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.bar-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.bar-text {
  font-size: 26rpx;
  color: #999;
}

.bar-text.valid {
  color: #8ec5b9;
  font-weight: 600;
}

.bar-text.invalid {
  color: #ffa000;
}

.save-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 40rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #8ec5b9 0%, #6f9a8e 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(142, 197, 185, 0.4);
}

.save-btn text {
  display: flex;
  align-items: center;
}

.save-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.save-btn.disabled {
  opacity: 0.5;
}

/* ===== 占位空间 ===== */
.bottom-spacer {
  height: 20rpx;
}
