/* pages/emotion-trash/index.wxss */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 装饰背景 */
.bg-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.bg-deco-1 {
  top: -100rpx;
  right: -80rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255, 181, 169, 0.12) 0%, transparent 70%);
  animation: float 8s ease-in-out infinite;
}

.bg-deco-2 {
  bottom: 30%;
  left: -100rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.1) 0%, transparent 70%);
  animation: float 10s ease-in-out infinite reverse;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(20rpx, -20rpx) scale(1.05); }
  66% { transform: translate(-15rpx, 15rpx) scale(0.95); }
}

/* 头部 */
.header {
  padding: 48rpx 40rpx 24rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.title-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, rgba(255, 181, 169, 0.15) 0%, rgba(255, 130, 100, 0.08) 100%);
  padding: 14rpx 32rpx;
  border-radius: var(--radius-full);
  border: 1px solid rgba(255, 181, 169, 0.2);
  box-shadow: 0 4rpx 20rpx rgba(255, 181, 169, 0.15);
}

.title-text {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff9f8f 0%, #ff6b81 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* 主内容 */
.main-content {
  flex: 1;
  padding: 16rpx 32rpx;
  position: relative;
  z-index: 1;
}

/* 纸条卡片 */
.paper-card {
  background: #FFFEF5;
  border-radius: var(--radius-xl);
  padding: 32rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  border: 1px solid rgba(210, 200, 170, 0.3);
  min-height: 320rpx;
}

.paper-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 60rpx;
  width: 2rpx;
  height: 100%;
  background: rgba(255, 107, 107, 0.15);
}

.paper-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-left: 28rpx;
}

.paper-lines {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.paper-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.emotion-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.8;
  padding-left: 28rpx;
  background: transparent;
}

.paper-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-left: 28rpx;
}

.char-count {
  font-size: 24rpx;
  color: var(--text-disabled);
}

/* 快捷标签 */
.quick-tags {
  margin-top: 32rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.emotion-tag {
  padding: 12rpx 28rpx;
  background: var(--surface-white);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: var(--text-secondary);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-light);
  transition: all var(--transition-base);
}

.emotion-tag:active {
  transform: scale(0.95);
}

.tag-selected {
  background: linear-gradient(135deg, rgba(255, 181, 169, 0.2) 0%, rgba(255, 130, 100, 0.1) 100%);
  color: #FF6B81;
  border-color: rgba(255, 181, 169, 0.4);
}

/* 丢掉按钮 */
.action-area {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.btn-throw {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 80rpx;
  border-radius: var(--radius-full);
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF9F8F 0%, #FF6B81 100%);
  color: #fff;
  box-shadow: 0 6rpx 28rpx rgba(255, 107, 129, 0.35);
  border: none;
  letter-spacing: 1rpx;
}

.btn-throw::after {
  border: none;
}

.btn-throw:active {
  transform: scale(0.96);
}

.btn-disabled {
  opacity: 0.5;
  box-shadow: none;
}

/* 动画区域 */
.animation-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  min-height: 60vh;
}

/* 纸条动画 */
.paper-anim {
  background: #FFFEF5;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  max-width: 500rpx;
  position: relative;
  z-index: 2;
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.paper-content-anim {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.paper-anim.crumple {
  transform: scale(0.7) rotate(10deg);
  opacity: 0.8;
}

.paper-anim.fall {
  transform: translateY(300rpx) scale(0.4) rotate(25deg);
  opacity: 0.4;
  transition-duration: 0.8s;
}

.paper-anim.shred {
  transform: translateY(350rpx) scale(0);
  opacity: 0;
  transition-duration: 0.4s;
}

/* 碎纸片 */
.shreds {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 400rpx;
  z-index: 3;
  pointer-events: none;
}

.shred {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  animation: shred-fly 1.2s ease-out forwards;
}

@keyframes shred-fly {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(var(--tx), var(--ty)) rotate(var(--rot)) scale(0);
    opacity: 0;
  }
}

/* 垃圾桶 */
.trash-can {
  position: absolute;
  bottom: 15%;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trash-lid {
  width: 120rpx;
  height: 16rpx;
  background: #8B7355;
  border-radius: 6rpx 6rpx 0 0;
  transition: transform 0.3s ease;
  transform-origin: left bottom;
}

.trash-open .trash-lid {
  transform: rotate(-30deg);
}

.trash-body {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(180deg, #A0896C 0%, #8B7355 100%);
  border-radius: 8rpx 8rpx 12rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.trash-line {
  width: 100%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 完成状态 */
.done-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  position: relative;
  z-index: 1;
  animation: fadeInUp 0.6s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.done-icon {
  margin-bottom: 24rpx;
  animation: bounce 0.6s ease;
}

@keyframes bounce {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.done-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-start);
  margin-bottom: 40rpx;
}

.healing-card {
  background: var(--surface-white);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(142, 197, 185, 0.2);
  margin-bottom: 48rpx;
  width: 100%;
  box-sizing: border-box;
}

.healing-quote {
  font-size: 30rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  text-align: center;
}

.btn-restart {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 64rpx;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  background: var(--surface-white);
  color: var(--primary-start);
  border: 2rpx solid var(--primary-start);
  box-shadow: var(--shadow-sm);
}

.btn-restart::after {
  border: none;
}

.btn-restart:active {
  transform: scale(0.96);
  background: rgba(142, 197, 185, 0.05);
}
