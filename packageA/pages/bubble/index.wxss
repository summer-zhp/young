/* packageA/pages/bubble/index.wxss */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(165deg, #F0F4F3 0%, #E8F0ED 40%, #F2EDE8 100%);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 背景 */
.bg-blobs { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.bg-blob { position: absolute; border-radius: 50%; filter: blur(80rpx); opacity: 0.22; }
.blob-a { width: 320rpx; height: 320rpx; top: -60rpx; right: -60rpx; background: #FFB5A9; animation: bd 14s ease-in-out infinite; }
.blob-b { width: 260rpx; height: 260rpx; bottom: 30%; left: -80rpx; background: #A8D5CC; animation: bd 18s ease-in-out infinite reverse; }
.blob-c { width: 200rpx; height: 200rpx; bottom: -40rpx; right: 20%; background: #FFE4A0; opacity: 0.16; animation: bd 12s ease-in-out infinite; }
@keyframes bd { 0%,100%{transform:translate(0,0) scale(1)} 33%{transform:translate(20rpx,-25rpx) scale(1.06)} 66%{transform:translate(-15rpx,15rpx) scale(0.94)} }

/* 头部 */
.header { padding: 48rpx 40rpx 12rpx; text-align: center; position: relative; z-index: 2; }
.title-pill {
  display: inline-flex; background: rgba(255,255,255,0.65); backdrop-filter: blur(20rpx);
  padding: 14rpx 36rpx; border-radius: 999rpx; border: 1px solid rgba(255,255,255,0.8);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
}
.title-text {
  font-size: 36rpx; font-weight: 800; letter-spacing: 2rpx;
  background: linear-gradient(135deg, #FF9F8F, #FF6B81);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}

/* 计分板 */
.score-bar {
  position: relative; z-index: 2; margin: 8rpx 32rpx 12rpx;
  background: rgba(255,255,255,0.7); backdrop-filter: blur(16rpx);
  border-radius: 24rpx; padding: 16rpx 24rpx;
  border: 1px solid rgba(255,255,255,0.8);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  animation: si 0.3s ease;
}
@keyframes si { from{opacity:0;transform:translateY(-16rpx)} to{opacity:1;transform:translateY(0)} }
.score-main { display: flex; align-items: baseline; gap: 4rpx; margin-bottom: 10rpx; }
.score-num { font-size: 48rpx; font-weight: 800; color: #8EC5B9; line-height: 1; font-feature-settings: 'tnum'; }
.score-unit { font-size: 24rpx; color: #8A9E98; }
.score-progress { height: 6rpx; background: rgba(142,197,185,0.15); border-radius: 999rpx; overflow: hidden; }
.score-fill { height: 100%; background: linear-gradient(90deg,#8EC5B9,#6FA99A); border-radius: 999rpx; transition: width 0.3s ease; }

/* 游戏区域 */
.game-area { flex: 1; position: relative; z-index: 1; margin: 0 16rpx; min-height: 500rpx; }

/* 泡泡场地 - 泡泡用绝对定位散落 */
.bubble-field { position: relative; width: 100%; height: 100%; min-height: 500rpx; }

/* 单个泡泡 */
.bubble-item {
  position: absolute;
  animation: bubbleIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both;
}
@keyframes bubbleIn { from{opacity:0;transform:scale(0.2)} to{opacity:1;transform:scale(1)} }

/* 泡泡主体 */
.bbody {
  width: 100%; height: 100%; border-radius: 50%; position: relative;
  box-shadow: inset -4rpx -6rpx 14rpx rgba(0,0,0,0.06), inset 4rpx 4rpx 10rpx rgba(255,255,255,0.7),
    3rpx 6rpx 16rpx rgba(0,0,0,0.07);
  animation: gentleDrift 4s ease-in-out infinite;
}
.bubble-item:active .bbody { transform: scale(0.88); }
@keyframes gentleDrift {
  0%,100% { transform: translate(0,0) scale(1); }
  25% { transform: translate(6rpx,-8rpx) scale(1.02,0.98); }
  50% { transform: translate(-4rpx,6rpx) scale(0.98,1.02); }
  75% { transform: translate(5rpx,4rpx) scale(1.01,0.99); }
}

.bshine {
  position: absolute; top: 14%; left: 18%; width: 35%; height: 30%; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0.2) 55%, transparent 80%);
  pointer-events: none;
}
.bdot {
  position: absolute; top: 20%; left: 24%; width: 10%; height: 10%; border-radius: 50%;
  background: rgba(255,255,255,0.95); pointer-events: none;
}

/* 戳破 */
.bpop .bbody { animation: popBurst 0.35s ease forwards !important; }
@keyframes popBurst { 0%{transform:scale(1);opacity:1} 35%{transform:scale(1.3);opacity:0.8} 100%{transform:scale(0);opacity:0} }

/* 粒子 */
.pop-fx { position: absolute; inset: 0; pointer-events: none; z-index: 5; }
.px {
  position: absolute; width: 14rpx; height: 14rpx; border-radius: 50%;
  top: 50%; left: 50%; margin: -7rpx 0 0 -7rpx; opacity: 0;
}
.bpop .px { animation: pxFly 0.45s ease-out forwards; }
@keyframes pxFly { 0%{transform:translate(0,0) scale(1);opacity:1} 100%{transform:translate(var(--tx),var(--ty)) scale(0.2);opacity:0} }

/* 超时淡出 */
.bfade .bbody { animation: fadeOut 0.4s ease forwards !important; }
@keyframes fadeOut { to { transform: scale(0.4); opacity: 0; } }

/* 生命环 */
.fade-ring {
  position: absolute; inset: -6rpx; border-radius: 50%; pointer-events: none;
}
.ring-track {
  width: 100%; height: 100%; border-radius: 50%;
  border: 4rpx solid rgba(0,0,0,0.06);
}
.ring-fill {
  position: absolute; inset: -4rpx; border-radius: 50%;
  border: 4rpx solid transparent;
  border-top-color: rgba(255,107,129,0.4);
  animation: ringSpin linear forwards;
}
@keyframes ringSpin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }

/* 连击 */
.combo {
  position: fixed; top: 38%; left: 50%; transform: translate(-50%,-50%);
  z-index: 100; pointer-events: none;
  animation: comboPop 0.4s cubic-bezier(0.34,1.56,0.64,1);
}
.combo-txt {
  font-size: 56rpx; font-weight: 800; color: #FF6B81;
  text-shadow: 0 4rpx 16rpx rgba(255,107,129,0.35); letter-spacing: 4rpx;
}
@keyframes comboPop { from{transform:translate(-50%,-50%) scale(0.4);opacity:0} to{transform:translate(-50%,-50%) scale(1);opacity:1} }

/* 空闲 */
.idle-scene { display: flex; justify-content: center; align-items: center; min-height: 280rpx; position: relative; }
.idle-b { position: absolute; }
.idle-b .bbody { box-shadow: inset -4rpx -6rpx 14rpx rgba(0,0,0,0.06), inset 4rpx 4rpx 10rpx rgba(255,255,255,0.7), 3rpx 6rpx 16rpx rgba(0,0,0,0.07); }
.ub1 { top: 12%; left: 15%; animation: idF 3.5s ease-in-out infinite; }
.ub2 { top: 8%; right: 18%; animation: idF 4.2s ease-in-out infinite 0.5s; }
.ub3 { bottom: 18%; left: 25%; animation: idF 3.8s ease-in-out infinite 1s; }
.ub4 { bottom: 15%; right: 15%; animation: idF 4s ease-in-out infinite 1.5s; }
.ub1 .bbody, .ub4 .bbody { width: 110rpx; height: 110rpx; }
.ub2 .bbody, .ub3 .bbody { width: 90rpx; height: 90rpx; }
@keyframes idF { 0%,100%{transform:translateY(0) scale(1)} 50%{transform:translateY(-24rpx) scale(1.06)} }

/* 游戏介绍 */
.intro-section { position: relative; z-index: 2; padding: 0 32rpx; margin-top: 100rpx; }
.intro-card {
  background: rgba(255,255,255,0.7); backdrop-filter: blur(16rpx);
  border-radius: 24rpx; padding: 28rpx 32rpx; margin-bottom: 20rpx;
  border: 1px solid rgba(255,255,255,0.8);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.intro-title {
  display: block; font-size: 30rpx; font-weight: 700; color: #5A9284;
  margin-bottom: 20rpx;
}
.intro-rules { display: flex; flex-direction: column; gap: 18rpx; }
.rule-item { display: flex; align-items: center; gap: 16rpx; }
.rule-num {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: linear-gradient(135deg, #8EC5B9, #6FA99A);
  color: #fff; font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.rule-text { font-size: 26rpx; color: #666; line-height: 1.5; }

.tip-card {
  display: flex; align-items: center; gap: 12rpx;
  background: rgba(255,228,160,0.15); border-radius: 20rpx;
  padding: 18rpx 24rpx; border: 1px solid rgba(255,228,160,0.25);
}
.tip-icon { font-size: 32rpx; flex-shrink: 0; }
.tip-text { font-size: 24rpx; color: #8A7E5A; line-height: 1.5; }

/* 底部 */
.bottom-bar { padding: 16rpx 48rpx 36rpx; position: relative; z-index: 2; }
.btn-go {
  width: 100%; height: 96rpx; border-radius: 32rpx; font-size: 32rpx; font-weight: 700;
  background: linear-gradient(135deg, #FF9F8F, #FF6B81); color: #fff; border: none;
  box-shadow: 0 8rpx 32rpx rgba(255,107,129,0.35); letter-spacing: 2rpx;
}
.btn-go::after { border: none; }
.btn-go:active { transform: scale(0.97); }
.btn-end {
  width: 100%; height: 88rpx; border-radius: 32rpx; font-size: 30rpx; font-weight: 600;
  background: rgba(255,255,255,0.7); color: #8A9E98; border: 1px solid rgba(0,0,0,0.06);
}
.btn-end::after { border: none; }
.btn-end:active { transform: scale(0.97); }

/* 弹窗 */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(8rpx); display: flex; align-items: center; justify-content: center; z-index: 200; }
.modal { width: 82%; max-width: 560rpx; background: #fff; border-radius: 32rpx; overflow: hidden; animation: mIn 0.3s cubic-bezier(0.34,1.56,0.64,1); }
@keyframes mIn { from{opacity:0;transform:translateY(60rpx) scale(0.92)} to{opacity:1;transform:none} }
.modal-hd { padding: 32rpx 32rpx 16rpx; text-align: center; }
.modal-tt { font-size: 34rpx; font-weight: 700; color: #1a1a1a; }
.modal-bd { padding: 8rpx 24rpx 28rpx; }
.diff-row {
  display: flex; align-items: center; justify-content: space-between;
  background: #F7F8F7; border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 16rpx;
  border: 2rpx solid transparent; transition: all 0.2s ease;
}
.diff-row:last-child { margin-bottom: 0; }
.diff-row:active { transform: scale(0.98); }
.diff-on { background: rgba(142,197,185,0.1); border-color: #8EC5B9; }
.diff-info { display: flex; flex-direction: column; gap: 4rpx; }
.diff-name { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.diff-on .diff-name { color: #6FA99A; }
.diff-desc { font-size: 22rpx; color: #999; }
.diff-check { width: 36rpx; height: 36rpx; border-radius: 50%; background: #8EC5B9; display: flex; align-items: center; justify-content: center; }
