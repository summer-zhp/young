<!-- pages/minesweeper/index.wxml -->
<view class="page">

  <!-- ===== Difficulty Selection Phase ===== -->
  <view wx:if="{{phase === 'select'}}" class="select-phase">
    <view class="decoration decoration-1"></view>
    <view class="decoration decoration-2"></view>

    <!-- Hero Header -->
    <view class="hero-header">
      <view class="hero-icon-row">
        <view class="hero-icon-box">
          <t-icon name="grid-view" size="64rpx" color="#8EC5B9"></t-icon>
        </view>
      </view>
      <text class="hero-title">扫雷</text>
      <text class="hero-desc">经典益智游戏，考验你的逻辑推理能力</text>
    </view>

    <!-- How to Play -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-icon-box">
          <t-icon name="bulletpoint" size="28rpx" color="#8EC5B9"></t-icon>
        </view>
        <text class="section-title">玩法说明</text>
      </view>
      <view class="steps-grid">
        <view class="step-item">
          <view class="step-num">1</view>
          <view class="step-content">
            <text class="step-label">点击揭开</text>
            <text class="step-desc">点击格子揭开，数字代表周围地雷数</text>
          </view>
        </view>
        <view class="step-item">
          <view class="step-num">2</view>
          <view class="step-content">
            <text class="step-label">长按标旗</text>
            <text class="step-desc">长按空白格标记旗帜，锁定可疑位置</text>
          </view>
        </view>
        <view class="step-item">
          <view class="step-num">3</view>
          <view class="step-content">
            <text class="step-label">推理排雷</text>
            <text class="step-desc">根据数字线索推理，避开所有地雷</text>
          </view>
        </view>
        <view class="step-item">
          <view class="step-num">4</view>
          <view class="step-content">
            <text class="step-label">安全通关</text>
            <text class="step-desc">揭开所有安全格子即为胜利</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Tips -->
    <view class="section-card tip-card">
      <view class="tip-row">
        <t-icon name="star-filled" size="28rpx" color="#FFB5A9"></t-icon>
        <text class="tip-text">首次点击绝对安全，放心大胆开始吧</text>
      </view>
    </view>

    <!-- Difficulty Selection -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-icon-box">
          <t-icon name="chart" size="28rpx" color="#8EC5B9"></t-icon>
        </view>
        <text class="section-title">选择难度</text>
      </view>
      <view class="difficulty-list">
        <view
          wx:for="{{difficulties}}"
          wx:key="id"
          class="difficulty-card"
          style="--card-delay: {{index * 100}}ms"
          bindtap="selectDifficulty"
          data-id="{{item.id}}"
        >
          <view class="diff-card-inner">
            <view class="diff-icon-wrapper diff-icon-{{item.id}}">
              <t-icon
                name="{{item.id === 'easy' ? 'grid-view' : (item.id === 'medium' ? 'grid-add' : 'component-grid')}}"
                size="40rpx"
                color="#FFFFFF"
              ></t-icon>
            </view>
            <view class="diff-info">
              <text class="diff-name">{{item.name}}</text>
              <text class="diff-desc">{{item.desc}}</text>
            </view>
            <view class="diff-start">
              <t-icon name="chevron-right" size="32rpx" color="#9A9A9A"></t-icon>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== Playing Phase ===== -->
  <view wx:if="{{phase === 'playing'}}" class="playing-phase">

    <!-- Top Bar -->
    <view class="top-bar">
      <view class="top-bar-btn" bindtap="backToSelect">
        <t-icon name="chevron-left" size="44rpx" color="#666"></t-icon>
      </view>
      <view class="top-bar-info">
        <view class="info-item">
          <t-icon name="add-circle" size="32rpx" color="#8EC5B9"></t-icon>
          <text class="info-text">{{minesLeft}}</text>
        </view>
        <view class="info-item">
          <t-icon name="time" size="32rpx" color="#8EC5B9"></t-icon>
          <text class="info-text">{{timeElapsed < 60 ? '00:' + (timeElapsed < 10 ? '0' + timeElapsed : timeElapsed) : (parseInt(timeElapsed/60) < 10 ? '0' + parseInt(timeElapsed/60) : parseInt(timeElapsed/60)) + ':' + (timeElapsed%60 < 10 ? '0' + timeElapsed%60 : timeElapsed%60)}}</text>
        </view>
      </view>
      <view class="top-bar-btn" bindtap="restartGame">
        <t-icon name="refresh" size="40rpx" color="#666"></t-icon>
      </view>
    </view>

    <!-- Difficulty Badge -->
    <view class="diff-badge diff-badge-{{currentDifficulty.id}}">
      <text class="diff-badge-text">{{currentDifficulty.name}}</text>
    </view>

    <!-- Game Board -->
    <scroll-view scroll-x="{{true}}" class="board-scroll" enhanced="{{true}}">
      <view class="board-container" style="width: {{cols * cellSize + 32}}px;">
        <view
          wx:for="{{board}}"
          wx:for-item="row"
          wx:for-index="rowIdx"
          wx:key="rowIdx"
          class="board-row"
        >
          <view
            wx:for="{{row}}"
            wx:for-item="cell"
            wx:for-index="colIdx"
            wx:key="colIdx"
            class="cell {{cell.revealed ? 'cell-revealed' : 'cell-hidden'}} {{cell.mine && cell.revealed ? 'cell-mine' : ''}}"
            style="width: {{cellSize}}px; height: {{cellSize}}px;"
            bindtap="onCellTap"
            bindlongpress="onCellLongPress"
            data-row="{{rowIdx}}"
            data-col="{{colIdx}}"
          >
            <!-- Unrevealed -->
            <view wx:if="{{!cell.revealed && !cell.flagged}}" class="cell-cover"></view>

            <!-- Flagged -->
            <view wx:if="{{cell.flagged && !cell.revealed}}" class="cell-flag">
              <t-icon name="flag" size="{{cellSize * 0.5}}rpx" color="#FF6B81"></t-icon>
            </view>

            <!-- Revealed Mine -->
            <view wx:if="{{cell.revealed && cell.mine}}" class="cell-mine-icon">
              <t-icon name="close-circle-filled" size="{{cellSize * 0.55}}rpx" color="#F44336"></t-icon>
            </view>

            <!-- Revealed Number -->
            <text
              wx:if="{{cell.revealed && !cell.mine && cell.adjacentMines > 0}}"
              class="cell-number cell-num-{{cell.adjacentMines}}"
              style="font-size: {{cellSize * 0.5}}px;"
            >{{cell.adjacentMines}}</text>

            <!-- Revealed Empty (0 adjacent) -->
            <view wx:if="{{cell.revealed && !cell.mine && cell.adjacentMines === 0}}" class="cell-empty"></view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- Bottom Hint -->
    <view class="bottom-hint">
      <text class="hint-text">点击揭开 · 长按标旗</text>
    </view>

    <!-- Game Over Overlay -->
    <view wx:if="{{gameOver}}" class="overlay">
      <view class="overlay-card">
        <view class="result-icon-box {{gameWon ? 'result-win' : 'result-lose'}}">
          <t-icon name="{{gameWon ? 'check-circle-filled' : 'close-circle-filled'}}" size="96rpx" color="{{gameWon ? '#4CAF50' : '#F44336'}}"></t-icon>
        </view>
        <text class="result-title">{{gameWon ? '恭喜过关!' : '踩到雷了!'}}</text>
        <text class="result-desc">{{gameWon ? '你成功排出了所有的雷' : '再接再厉，继续挑战'}}</text>

        <view class="result-stats">
          <view class="stat-item">
            <text class="stat-value">{{currentDifficulty.name}}</text>
            <text class="stat-label">难度</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{timeElapsed}}s</text>
            <text class="stat-label">用时</text>
          </view>
        </view>

        <view class="result-actions">
          <view class="result-btn btn-restart" bindtap="restartGame">
            <t-icon name="refresh" size="32rpx" color="#FFFFFF"></t-icon>
            <text class="result-btn-text">再来一局</text>
          </view>
          <view class="result-btn btn-change" bindtap="backToSelect">
            <t-icon name="chevron-left" size="32rpx" color="#8EC5B9"></t-icon>
            <text class="result-btn-text btn-change-text">切换难度</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
