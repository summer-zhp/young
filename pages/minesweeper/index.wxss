/* pages/minesweeper/index.wxss */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  position: relative;
  overflow: hidden;
}

/* ===== Decorations ===== */
.decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.decoration-1 {
  top: -150rpx; right: -100rpx;
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.12) 0%, transparent 70%);
  animation: float 8s ease-in-out infinite;
}

.decoration-2 {
  bottom: 20%; left: -150rpx;
  width: 350rpx; height: 350rpx;
  background: radial-gradient(circle, rgba(255, 181, 169, 0.1) 0%, transparent 70%);
  animation: float 10s ease-in-out infinite reverse;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30rpx, -30rpx) scale(1.05); }
  66% { transform: translate(-20rpx, 20rpx) scale(0.95); }
}

/* ===== Select Phase ===== */
.select-phase {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  position: relative;
}

/* Hero Header */
.hero-header {
  padding: 48rpx 40rpx 24rpx;
  text-align: center;
  position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center;
  gap: 12rpx;
}

.hero-icon-box {
  width: 120rpx; height: 120rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  border-radius: 40rpx;
  border: 2rpx solid rgba(142, 197, 185, 0.12);
  margin-bottom: 8rpx;
}

.hero-title {
  font-size: 52rpx; font-weight: 700; letter-spacing: 4rpx;
  background: linear-gradient(135deg, #8EC5B9 0%, #5A9284 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}

.hero-desc {
  font-size: 28rpx; color: var(--text-tertiary); line-height: 1.5;
}

/* Section Card */
.section-card {
  margin: 0 32rpx 24rpx;
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(142, 197, 185, 0.08);
  position: relative; z-index: 1;
}

.section-header {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-icon-box {
  width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(142, 197, 185, 0.1);
  border-radius: 12rpx;
}

.section-title {
  font-size: 30rpx; font-weight: 600; color: var(--text-primary);
}

/* Steps */
.steps-grid {
  display: flex; flex-direction: column; gap: 20rpx;
}

.step-item {
  display: flex; align-items: flex-start; gap: 20rpx;
}

.step-num {
  width: 44rpx; height: 44rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #8EC5B9 0%, #6FA99A 100%);
  color: #FFFFFF; font-size: 24rpx; font-weight: 700;
  border-radius: 50%;
}

.step-content {
  flex: 1; display: flex; flex-direction: column; gap: 4rpx;
  padding-top: 4rpx;
}

.step-label {
  font-size: 28rpx; font-weight: 600; color: var(--text-primary);
}

.step-desc {
  font-size: 24rpx; color: var(--text-tertiary); line-height: 1.5;
}

/* Tip Card */
.tip-card {
  padding: 24rpx 32rpx;
}

.tip-row {
  display: flex; align-items: center; gap: 12rpx;
}

.tip-text {
  font-size: 26rpx; color: var(--text-secondary); line-height: 1.5;
}

/* Difficulty Cards */
.difficulty-list {
  display: flex; flex-direction: column; gap: 20rpx;
}

.difficulty-card {
  opacity: 0;
  animation: cardSlideIn 0.5s ease-out forwards;
  animation-delay: var(--card-delay, 0ms);
}

@keyframes cardSlideIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.diff-card-inner {
  display: flex; align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(142, 197, 185, 0.04);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgba(142, 197, 185, 0.1);
  gap: 20rpx;
  transition: all var(--transition-base);
}

.difficulty-card:active .diff-card-inner {
  transform: scale(0.97);
  border-color: rgba(142, 197, 185, 0.25);
  background: rgba(142, 197, 185, 0.08);
}

.diff-icon-wrapper {
  width: 72rpx; height: 72rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 20rpx;
}

.diff-icon-easy {
  background: linear-gradient(135deg, #A8D8CC 0%, #8EC5B9 100%);
}

.diff-icon-medium {
  background: linear-gradient(135deg, #FFB5A9 0%, #FF9A8B 100%);
}

.diff-icon-hard {
  background: linear-gradient(135deg, #FF8370 0%, #FF6B5A 100%);
}

.diff-info {
  flex: 1; display: flex; flex-direction: column; gap: 6rpx;
}

.diff-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.diff-desc { font-size: 24rpx; color: var(--text-tertiary); }

.diff-start {
  width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
}

/* ===== Playing Phase ===== */
.playing-phase {
  min-height: 100vh;
  display: flex; flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Top Bar */
.top-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1rpx solid rgba(142, 197, 185, 0.1);
  position: relative; z-index: 10;
}

.top-bar-btn {
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--radius-lg);
  background: rgba(142, 197, 185, 0.08);
  transition: all var(--transition-base);
}

.top-bar-btn:active { transform: scale(0.92); background: rgba(142, 197, 185, 0.15); }

.top-bar-info { display: flex; align-items: center; gap: 32rpx; }

.info-item {
  display: flex; align-items: center; gap: 8rpx;
  background: rgba(142, 197, 185, 0.06);
  padding: 10rpx 20rpx;
  border-radius: var(--radius-full);
}

.info-text {
  font-size: 28rpx; font-weight: 600; color: var(--text-primary);
  font-variant-numeric: tabular-nums;
  min-width: 60rpx; text-align: center;
}

/* Difficulty Badge */
.diff-badge {
  display: flex; align-items: center; justify-content: center;
  margin-top: 16rpx;
}

.diff-badge-text {
  font-size: 24rpx; font-weight: 500;
  padding: 6rpx 24rpx;
  border-radius: var(--radius-full);
}

.diff-badge-easy .diff-badge-text {
  background: rgba(142, 197, 185, 0.1); color: #8EC5B9;
}

.diff-badge-medium .diff-badge-text {
  background: rgba(255, 181, 169, 0.1); color: #FF9A8B;
}

.diff-badge-hard .diff-badge-text {
  background: rgba(255, 107, 90, 0.1); color: #FF6B5A;
}

/* Board */
.board-scroll { flex: 1; width: 100%; }

.board-container { padding: 16px; margin: 0 auto; }

.board-row { display: flex; flex-direction: row; }

.cell {
  display: flex; align-items: center; justify-content: center;
  margin: 1px;
  transition: all var(--transition-fast);
  position: relative;
}

.cell-hidden { border-radius: 6rpx; }

.cell-cover {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #c8e6dc 0%, #b0d8ca 100%);
  border-radius: 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  transition: all var(--transition-fast);
}

.cell-hidden:active .cell-cover { transform: scale(0.9); opacity: 0.7; }

.cell-revealed { border-radius: 6rpx; background: rgba(255, 255, 255, 0.6); }
.cell-mine { background: rgba(244, 67, 54, 0.1); }

.cell-flag { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.cell-mine-icon { display: flex; align-items: center; justify-content: center; }
.cell-empty { width: 100%; height: 100%; }

.cell-number { font-weight: 700; line-height: 1; text-align: center; }

.cell-num-1 { color: #1976D2; }
.cell-num-2 { color: #388E3C; }
.cell-num-3 { color: #D32F2F; }
.cell-num-4 { color: #7B1FA2; }
.cell-num-5 { color: #880E4F; }
.cell-num-6 { color: #00838F; }
.cell-num-7 { color: #212121; }
.cell-num-8 { color: #9E9E9E; }

/* Bottom Hint */
.bottom-hint {
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.hint-text { font-size: 24rpx; color: var(--text-disabled); letter-spacing: 4rpx; }

/* ===== Overlay ===== */
.overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
  animation: overlayFadeIn 0.3s ease-out;
  backdrop-filter: blur(4px);
}

@keyframes overlayFadeIn {
  from { opacity: 0; } to { opacity: 1; }
}

.overlay-card {
  width: 600rpx;
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  padding: 56rpx 40rpx 48rpx;
  display: flex; flex-direction: column; align-items: center;
  gap: 20rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.15);
  animation: cardPopIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes cardPopIn {
  from { opacity: 0; transform: scale(0.8) translateY(40rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.result-icon-box {
  width: 128rpx; height: 128rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; margin-bottom: 8rpx;
}

.result-win { background: rgba(76, 175, 80, 0.1); }
.result-lose { background: rgba(244, 67, 54, 0.1); }

.result-title { font-size: 40rpx; font-weight: 700; color: var(--text-primary); }
.result-desc { font-size: 28rpx; color: var(--text-tertiary); margin-bottom: 8rpx; }

.result-stats { display: flex; align-items: center; gap: 40rpx; margin: 16rpx 0; }

.stat-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.stat-value { font-size: 32rpx; font-weight: 700; color: var(--primary-start); }
.stat-label { font-size: 22rpx; color: var(--text-tertiary); }
.stat-divider { width: 2rpx; height: 60rpx; background: rgba(142, 197, 185, 0.2); }

.result-actions { display: flex; flex-direction: column; gap: 20rpx; width: 100%; margin-top: 12rpx; }

.result-btn {
  display: flex; align-items: center; justify-content: center;
  gap: 12rpx; padding: 24rpx 0;
  border-radius: var(--radius-full); font-weight: 600;
  transition: all var(--transition-base);
}

.result-btn:active { transform: scale(0.96); }

.btn-restart {
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  box-shadow: 0 4rpx 20rpx rgba(142, 197, 185, 0.4);
}

.result-btn-text { font-size: 30rpx; color: #FFFFFF; }

.btn-change {
  background: rgba(142, 197, 185, 0.08);
  border: 1rpx solid rgba(142, 197, 185, 0.2);
}

.btn-change-text { color: var(--primary-start); }

@media (min-width: 768px) {
  .board-container { max-width: 600px; margin: 0 auto; }
}
