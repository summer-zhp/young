/* pages/sudoku/index.wxss */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  position: relative;
}

/* ===== Decorations ===== */
.decoration {
  position: absolute; border-radius: 50%;
  pointer-events: none; z-index: 0;
}

.decoration-1 {
  top: -120rpx; right: -80rpx;
  width: 360rpx; height: 360rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.1) 0%, transparent 70%);
}

.decoration-2 {
  bottom: 30%; left: -120rpx;
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(255, 181, 169, 0.08) 0%, transparent 70%);
}

/* ===== Select Phase ===== */
.select-phase {
  min-height: 100vh;
  display: flex; flex-direction: column;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  position: relative;
}

/* Hero Header */
.hero-header {
  padding: 48rpx 40rpx 24rpx;
  text-align: center; position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center;
  gap: 12rpx;
}

.hero-icon-box {
  width: 120rpx; height: 120rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #8EC5B9 0%, #6FA99A 100%);
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(142, 197, 185, 0.3);
  margin-bottom: 8rpx;
}

.hero-title {
  font-size: 52rpx; font-weight: 700; color: #1A1A1A;
}

.hero-desc {
  font-size: 28rpx; color: #999999; line-height: 1.5;
}

/* Section Card */
.section-card {
  margin: 0 32rpx 24rpx;
  background: #ffffff;
  border-radius: var(--radius-2xl);
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(142, 197, 185, 0.08);
  position: relative; z-index: 1;
}

.section-header {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-icon-box {
  width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(142, 197, 185, 0.1);
  border-radius: 12rpx;
}

.section-title {
  font-size: 30rpx; font-weight: 600; color: #1A1A1A;
}

/* Steps */
.steps-list {
  display: flex; flex-direction: column; gap: 20rpx;
}

.step-item {
  display: flex; align-items: flex-start; gap: 20rpx;
}

.step-num {
  width: 44rpx; height: 44rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #8EC5B9 0%, #6FA99A 100%);
  color: #FFFFFF; font-size: 24rpx; font-weight: 700;
  border-radius: 50%;
}

.step-content {
  flex: 1; display: flex; flex-direction: column; gap: 4rpx;
  padding-top: 4rpx;
}

.step-label { font-size: 28rpx; font-weight: 600; color: #1A1A1A; }
.step-desc { font-size: 24rpx; color: #999999; line-height: 1.5; }

/* Tip Card */
.tip-card {
  padding: 24rpx 32rpx;
}

.tip-row {
  display: flex; align-items: center; gap: 12rpx;
}

.tip-text {
  font-size: 26rpx; color: #666666; line-height: 1.5;
}

/* Difficulty List */
.difficulty-list {
  display: flex; flex-direction: column; gap: 20rpx;
}

.difficulty-card {
  opacity: 0;
  animation: cardSlideIn 0.5s ease-out forwards;
}

.difficulty-card:nth-child(1) { animation-delay: 0ms; }
.difficulty-card:nth-child(2) { animation-delay: 100ms; }
.difficulty-card:nth-child(3) { animation-delay: 200ms; }

@keyframes cardSlideIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.diff-card-inner {
  display: flex; align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(142, 197, 185, 0.04);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgba(142, 197, 185, 0.1);
  gap: 20rpx;
  transition: all 0.2s ease;
}

.difficulty-card:active .diff-card-inner {
  transform: scale(0.97);
  border-color: rgba(142, 197, 185, 0.25);
  background: rgba(142, 197, 185, 0.08);
}

.diff-icon-wrapper {
  width: 72rpx; height: 72rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 20rpx;
}

.diff-icon-easy { background: linear-gradient(135deg, #A8D8CC 0%, #8EC5B9 100%); }
.diff-icon-medium { background: linear-gradient(135deg, #FFB5A9 0%, #FF9A8B 100%); }
.diff-icon-hard { background: linear-gradient(135deg, #FF8370 0%, #FF6B5A 100%); }

.diff-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.diff-name { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.diff-desc { font-size: 24rpx; color: #999999; }
.diff-start { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }

/* ===== Playing Phase ===== */
.playing-phase {
  min-height: 100vh;
  display: flex; flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Top Bar */
.top-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
}

.top-bar-left {
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.top-bar-center { flex: 1; display: flex; justify-content: center; }

.mistakes-counter {
  display: flex; align-items: center; gap: 8rpx;
  background: #ffffff; padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.mistakes-text { font-size: 26rpx; color: #CCCCCC; font-weight: 500; }
.mistakes-active { color: #F44336; }

.top-bar-right { display: flex; align-items: center; gap: 12rpx; }

.timer-box {
  display: flex; align-items: center; gap: 6rpx;
  background: #ffffff; padding: 10rpx 16rpx;
  border-radius: 9999rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.timer-text {
  font-size: 26rpx; color: #8EC5B9; font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.restart-btn {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* Difficulty Badge */
.diff-badge {
  display: flex; align-items: center; justify-content: center;
  padding: 8rpx 0;
}

.diff-badge-text {
  font-size: 24rpx; font-weight: 500;
  padding: 6rpx 24rpx; border-radius: 9999rpx;
}

.diff-badge-easy .diff-badge-text { background: rgba(142, 197, 185, 0.1); color: #8EC5B9; }
.diff-badge-medium .diff-badge-text { background: rgba(255, 181, 169, 0.1); color: #FF9A8B; }
.diff-badge-hard .diff-badge-text { background: rgba(255, 107, 90, 0.1); color: #FF6B5A; }

/* Sudoku Grid */
.grid-container {
  display: flex; justify-content: center;
  padding: 12rpx 16rpx;
}

.sudoku-grid {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 4rpx;
  box-shadow: 0 8rpx 40rpx rgba(142, 197, 185, 0.2), 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 3rpx solid #8EC5B9;
  overflow: hidden;
}

.grid-row { display: flex; }
.grid-row.row-box-border { border-bottom: 3rpx solid #8EC5B9; }

.grid-cell {
  display: flex; align-items: center; justify-content: center;
  border-right: 1rpx solid #E0E0E0;
  border-bottom: 1rpx solid #E0E0E0;
  transition: background-color 0.15s ease;
}

.grid-cell.col-box-border { border-right: 3rpx solid #8EC5B9; }
.grid-row:last-child .grid-cell { border-bottom: none; }
.grid-cell:last-child { border-right: none; }

.cell-initial { background-color: #FAFBFC; }
.cell-user { background-color: #ffffff; }

.cell-selected {
  background-color: rgba(142, 197, 185, 0.25) !important;
  box-shadow: inset 0 0 0 2rpx #8EC5B9;
}

.cell-highlight { background-color: rgba(142, 197, 185, 0.08) !important; }
.cell-error { background-color: rgba(244, 67, 54, 0.05) !important; }

.cell-text { font-size: 34rpx; line-height: 1; }
.cell-text-initial { font-size: 34rpx; font-weight: 700; color: #1A1A1A; line-height: 1; }
.cell-text-user { font-size: 34rpx; font-weight: 400; color: #8EC5B9; line-height: 1; }
.cell-text-error { font-size: 34rpx; font-weight: 500; color: #F44336; line-height: 1; }

/* Number Pad */
.number-pad {
  display: flex; justify-content: center; align-items: center;
  gap: 12rpx; padding: 24rpx 16rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.num-btn {
  width: 68rpx; height: 68rpx;
  border-radius: 50%; background: #ffffff;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.15s ease;
}

.num-btn:active { transform: scale(0.92); background: rgba(142, 197, 185, 0.15); }

.num-btn-text { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }

.num-btn-erase { background: #F5F5F5; }
.num-btn-erase:active { background: #EBEBEB; }

/* ===== Overlay ===== */
.game-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 10000;
  display: flex; align-items: center; justify-content: center;
}

.overlay-hide { opacity: 0; visibility: hidden; pointer-events: none; }

.overlay-mask { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); }

.overlay-content {
  position: relative; width: 580rpx; z-index: 1;
  background: #ffffff; border-radius: 32rpx;
  padding: 56rpx 40rpx 40rpx;
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.2);
  animation: overlayPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes overlayPop {
  from { transform: scale(0.5); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.overlay-icon-box { margin-bottom: 8rpx; }
.overlay-title { font-size: 40rpx; font-weight: 700; color: #1A1A1A; }
.overlay-subtitle { font-size: 28rpx; color: #999999; }

.overlay-stats { display: flex; align-items: center; gap: 40rpx; margin: 16rpx 0 8rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.stat-label { font-size: 24rpx; color: #BBBBBB; }
.stat-value { font-size: 32rpx; font-weight: 600; color: #8EC5B9; }
.stat-divider { width: 2rpx; height: 60rpx; background: #E8E8E8; }

.overlay-actions { display: flex; gap: 20rpx; width: 100%; margin-top: 8rpx; }

.overlay-btn {
  flex: 1; height: 88rpx;
  border-radius: 44rpx; font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  border: none; padding: 0; margin: 0; line-height: 88rpx;
}

.overlay-btn::after { border: none; }

.overlay-btn-secondary { background: #F5F5F5; color: #666666; }
.overlay-btn-secondary:active { background: #EBEBEB; }

.overlay-btn-primary {
  background: linear-gradient(135deg, #8EC5B9 0%, #6FA99A 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(142, 197, 185, 0.35);
}
