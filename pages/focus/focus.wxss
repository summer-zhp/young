/* pages/focus/focus.wxss - 专注时钟重新设计 */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5F7F8 0%, #E8F5F3 100%);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

/* ===== 装饰背景 ===== */
.bg-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.bg-deco-1 {
  top: -150rpx;
  right: -100rpx;
  width: 350rpx;
  height: 350rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.12) 0%, transparent 70%);
  animation: float 8s ease-in-out infinite;
}

.bg-deco-2 {
  bottom: 20%;
  left: -120rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255, 181, 169, 0.08) 0%, transparent 70%);
  animation: float 10s ease-in-out infinite reverse;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(25rpx, -25rpx) scale(1.05); }
  66% { transform: translate(-20rpx, 20rpx) scale(0.95); }
}

/* ===== 头部 ===== */
.header {
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.brand-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  padding: 14rpx 32rpx;
  border-radius: var(--radius-full);
  border: 1px solid rgba(142, 197, 185, 0.2);
  box-shadow: 0 4rpx 20rpx rgba(142, 197, 185, 0.15);
}

.brand-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.brand-title {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 1rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ===== 时长选择器 ===== */
.duration-selector {
  padding: 0 32rpx 32rpx;
  position: relative;
  z-index: 1;
}

.duration-options {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.duration-option {
  flex: 1;
  padding: 28rpx 16rpx;
  background: var(--surface-white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all var(--transition-base);
  border: 2rpx solid transparent;
  cursor: pointer;
}

.duration-option:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-xs);
}

.duration-option.active {
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  border-color: rgba(142, 197, 185, 0.3);
  box-shadow: var(--shadow-primary);
}

.option-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-secondary);
  transition: color var(--transition-base);
}

.duration-option.active .option-label {
  color: var(--surface-white);
}

.option-unit {
  font-size: 22rpx;
  color: var(--text-tertiary);
  transition: color var(--transition-base);
}

.duration-option.active .option-unit {
  color: rgba(255, 255, 255, 0.85);
}

.custom-btn-wrapper {
  display: flex;
  justify-content: center;
}

.custom-btn {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  border-radius: var(--radius-full);
  border: 1px solid rgba(142, 197, 185, 0.2);
  transition: all var(--transition-base);
}

.custom-btn:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.2) 0%, rgba(111, 169, 154, 0.12) 100%);
}

.custom-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

.custom-btn text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-dark);
}

/* ===== 计时器容器 ===== */
.timer-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  position: relative;
  z-index: 1;
}

.timer-ring {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.timer-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.ring-bg {
  opacity: 0.5;
}

.ring-progress {
  transition: stroke-dashoffset 1s linear;
  filter: drop-shadow(0 4rpx 12rpx rgba(142, 197, 185, 0.4));
}

.timer-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.time {
  font-size: 80rpx;
  font-weight: 300;
  color: var(--text-primary);
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
  letter-spacing: 2rpx;
  line-height: 1;
}

.timer-status {
  font-size: 26rpx;
  color: var(--primary-start);
  font-weight: 600;
  padding: 8rpx 24rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  border-radius: var(--radius-full);
  animation: pulse 2s ease-in-out infinite;
}

.timer-quote {
  text-align: center;
  padding: 0 40rpx;
  max-width: 600rpx;
}

.timer-quote text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  line-height: 1.8;
  font-weight: 400;
}

/* ===== 控制按钮 ===== */
.controls {
  padding: 0 32rpx 32rpx;
  position: relative;
  z-index: 1;
}

.controls-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.btn-primary,
.btn-secondary,
.btn-pause {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 36rpx 72rpx;
  border-radius: var(--radius-full);
  font-size: 32rpx;
  font-weight: 600;
  transition: all var(--transition-base);
  min-width: 280rpx;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  color: var(--surface-white);
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-primary-hover);
}

.btn-secondary {
  background: var(--surface-white);
  color: var(--text-secondary);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border-light);
}

.btn-secondary:active {
  background: var(--surface-hover);
  box-shadow: var(--shadow-sm);
  transform: scale(0.98);
}

.btn-pause {
  background: linear-gradient(135deg, var(--accent-pink) 0%, rgba(255, 130, 100, 0.8) 100%);
  color: var(--surface-white);
  box-shadow: 0 4rpx 20rpx rgba(255, 181, 169, 0.4);
}

.btn-pause:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 14rpx rgba(255, 181, 169, 0.35);
}

.btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

.btn-group {
  display: flex;
  gap: 20rpx;
}

.btn-group .btn-secondary,
.btn-group .btn-primary,
.btn-group .btn-pause {
  flex: 1;
  min-width: auto;
  padding: 36rpx 48rpx;
}

/* ===== 统计区域 ===== */
.stats-section {
  padding: 0 32rpx 40rpx;
  position: relative;
  z-index: 1;
}

.stats-card {
  display: flex;
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-md);
  padding: 40rpx 32rpx;
  border: 1px solid rgba(142, 197, 185, 0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-icon {
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  border-radius: 50%;
}

.stat-item:last-child .stat-icon {
  background: linear-gradient(135deg, rgba(255, 181, 169, 0.2) 0%, rgba(255, 130, 100, 0.1) 100%);
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary-start);
  font-feature-settings: 'tnum';
}

.stat-item:last-child .stat-value {
  color: var(--accent-pink);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
}

.stat-divider {
  width: 2rpx;
  background: linear-gradient(180deg, transparent 0%, var(--border-light) 50%, transparent 100%);
  margin: 0 32rpx;
}

/* ===== 弹窗样式 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  backdrop-filter: blur(4px);
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 560rpx;
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  padding: 40rpx 36rpx 36rpx;
  z-index: 1001;
  box-shadow: 0 12rpx 60rpx rgba(0, 0, 0, 0.25);
  animation: modalSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
  flex: 1;
}

.modal-body {
  padding-top: 8rpx;
}

.modal-body form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.duration-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.duration-input {
  flex: 1;
  box-sizing: border-box;
  padding: 12rpx 24rpx;
  padding-right: 100rpx;
  background: var(--surface-hover);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-primary);
  height: 45px;
  line-height: 45px;
  transition: all var(--transition-base);
  font-feature-settings: 'tnum';
}

.duration-input:focus {
  background: var(--border-light);
}

.input-placeholder {
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.duration-unit {
  position: absolute;
  right: 24rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

.submit-btn {
  width: 100%;
  padding: 22rpx 0;
  margin-top: 20px;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  color: var(--surface-white);
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
  border: none;
  transition: all var(--transition-base);
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-primary-hover);
}
