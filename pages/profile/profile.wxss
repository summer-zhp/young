/* pages/profile/profile.wxss - 个人中心页面重新设计 */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

/* ===== 装饰背景 ===== */
.bg-decoration {
  position: absolute;
  top: -200rpx;
  right: -200rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

/* ===== 登录区域 - 全新设计 ===== */
.login-section {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  position: relative;
  z-index: 1;
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.06);
  gap: 20rpx;
  width: 100%;
  max-width: 560rpx;
  animation: cardEnter 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes cardEnter {
  from {
    opacity: 0;
    transform: translateY(60rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.login-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.login-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.login-title-highlight {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
}

.login-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
}

.login-btn {
  width: 70%;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  border-radius: var(--radius-full);
  margin-top: 24rpx;
  box-shadow: var(--shadow-primary);
  transition: all var(--transition-base);
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-primary-hover);
}

.login-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--surface-white);
  letter-spacing: 2rpx;
}

.login-tip {
  font-size: 22rpx;
  color: var(--text-disabled);
  margin-top: 12rpx;
}

/* ===== 内容区域 ===== */
.content-section {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

/* ===== 用户信息卡片 - 全新设计 ===== */
.user-card-wrapper {
  margin: 32rpx 32rpx 24rpx;
}

.user-card {
  position: relative;
  padding: 48rpx;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-dark) 100%);
  border-radius: var(--radius-2xl);
  box-shadow: 0 8rpx 40rpx rgba(142, 197, 185, 0.35);
  overflow: hidden;
}

.user-card-bg {
  position: absolute;
  inset: 0;
  background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>');
  opacity: 0.5;
  pointer-events: none;
}

.user-card-content {
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  z-index: 1;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  transition: all var(--transition-base);
}

.user-avatar:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.3);
}

.avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.user-nickname {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--surface-white);
  letter-spacing: 1rpx;
}

.user-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-days,
.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-divider {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

.logout-wrapper {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  z-index: 2;
}

.logout-btn {
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--surface-white);
  backdrop-filter: blur(10px);
  transition: all var(--transition-base);
}

.logout-btn:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.95);
}

/* ===== 统计数据 - 全新设计 ===== */
.stats-section {
  padding: 0 32rpx 32rpx;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
  background: var(--surface-white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  transition: all var(--transition-base);
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-start), var(--primary-end));
  transform: scaleX(0);
  transition: transform var(--transition-base);
}

.stat-card:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-sm);
}

.stat-card:active::before {
  transform: scaleX(1);
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary-start);
  font-feature-settings: 'tnum';
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.4;
}

/* ===== 职位信息 - 全新设计 ===== */
.job-section {
  padding: 0 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

.job-card {
  background: var(--surface-white);
  border-radius: var(--radius-xl);
  padding: 36rpx;
  box-shadow: var(--shadow-md);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all var(--transition-base);
}

.job-card:active {
  box-shadow: var(--shadow-sm);
  transform: translateY(2rpx);
}

.job-content {
  flex: 1;
  min-width: 0;
}

.job-text {
  font-size: 34rpx;
  color: var(--text-primary);
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.job-empty {
  font-size: 30rpx;
  color: var(--text-tertiary);
  font-style: italic;
}

.job-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.job-btn {
  padding: 14rpx 32rpx;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  color: var(--surface-white);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
  transition: all var(--transition-base);
  box-shadow: 0 2rpx 12rpx rgba(142, 197, 185, 0.3);
}

.job-btn:active {
  transform: scale(0.96);
  box-shadow: 0 1rpx 8rpx rgba(142, 197, 185, 0.25);
}

.job-btn-outline {
  background: var(--surface-hover);
  color: var(--text-secondary);
  box-shadow: none;
}

.job-btn-outline:active {
  background: var(--border-light);
}

/* ===== 收藏列表 ===== */
.favorites-section {
  padding: 0 32rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-header-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--primary-start);
  font-weight: 500;
  transition: color var(--transition-base);
}

.section-more:active {
  color: var(--primary-dark);
}

.favorites-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.favorite-item {
  padding: 32rpx;
  background: var(--surface-white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base);
}

.favorite-item:active {
  box-shadow: var(--shadow-md);
  transform: translateX(8rpx);
}

.favorite-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-favorites {
  padding: 80rpx 0;
  text-align: center;
  background: var(--surface-white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* ===== 客服按钮 - 全新设计 ===== */
.customer-service-section {
  padding: 0 32rpx 48rpx;
}

.customer-service-btn {
  width: 100%;
  padding: 36rpx 0;
  background: linear-gradient(135deg, rgba(255, 181, 169, 0.25) 0%, rgba(255, 130, 100, 0.15) 100%);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 181, 169, 0.25);
  transition: all var(--transition-base);
  border: 1px solid rgba(255, 181, 169, 0.2);
}

.customer-service-btn::after {
  border: none;
}

.customer-service-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 14rpx rgba(255, 181, 169, 0.2);
}

.cs-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.customer-service-btn:active .cs-icon {
  opacity: 0.8;
}

.cs-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

/* ===== 弹窗样式 - 优化 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  backdrop-filter: blur(4px);
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 560rpx;
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  padding: 40rpx 36rpx 36rpx;
  z-index: 1001;
  box-shadow: 0 12rpx 60rpx rgba(0, 0, 0, 0.25);
  animation: modalSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
  flex: 1;
}

.modal-body {
  padding-top: 8rpx;
}

.modal-body form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.job-input {
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 24rpx;
  background: var(--surface-hover);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 45px;
  height: 45px;
  transition: all var(--transition-base);
}

.job-input:focus {
  background: var(--border-light);
}

.input-placeholder {
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.submit-btn {
  width: 100%;
  padding: 22rpx 0;
  margin-top: 20px;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  color: var(--surface-white);
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
  border: none;
  transition: all var(--transition-base);
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-primary-hover);
}
