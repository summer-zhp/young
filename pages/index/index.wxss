/* pages/index/index.wxss - 首页重新设计 */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ===== 背景装饰 ===== */
.bg-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #F5F7F8 0%, #E8F5F3 50%, #F0F9F8 100%);
  z-index: 0;
}

.bg-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.bg-deco-1 {
  top: -150rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.12) 0%, transparent 70%);
  animation: float 8s ease-in-out infinite;
}

.bg-deco-2 {
  bottom: 30%;
  left: -120rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(255, 181, 169, 0.1) 0%, transparent 70%);
  animation: float 10s ease-in-out infinite reverse;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30rpx, -30rpx) scale(1.05); }
  66% { transform: translate(-20rpx, 20rpx) scale(0.95); }
}

/* ===== 头部 - 全新设计 ===== */
.header {
  padding: 64rpx 40rpx 0;
  text-align: center;
  position: relative;
  z-index: 1;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.brand-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  padding: 14rpx 36rpx;
  border-radius: var(--radius-full);
  border: 1px solid rgba(142, 197, 185, 0.2);
  box-shadow: 0 4rpx 20rpx rgba(142, 197, 185, 0.15);
}

.brand-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-title {
  font-size: 36rpx;
  font-weight: 600;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 1rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

/* ===== 主内容区域 ===== */
.main-content {
  flex: 1;
  padding: 24rpx 32rpx 48rpx;
  position: relative;
  z-index: 1;
}

/* ===== 倒计时卡片 ===== */
.countdown-card-wrapper {
  margin-bottom: 20rpx;
  animation: cardEnter 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.countdown-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-xl);
  gap: 24rpx;
  transition: all var(--transition-base);
}

.countdown-not-configured {
  background: var(--surface-white);
  box-shadow: var(--shadow-md);
  border: 1px dashed rgba(142, 197, 185, 0.3);
}

.countdown-not-configured:active {
  transform: scale(0.98);
  border-color: rgba(142, 197, 185, 0.5);
}

.countdown-rest {
  background: linear-gradient(135deg, rgba(255, 181, 169, 0.15) 0%, rgba(255, 150, 130, 0.08) 100%);
  border: 1px solid rgba(255, 181, 169, 0.2);
}

.countdown-working {
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-dark) 100%);
  box-shadow: 0 6rpx 24rpx rgba(142, 197, 185, 0.3);
}

.countdown-before_work {
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.12) 0%, rgba(111, 169, 154, 0.06) 100%);
  border: 1px solid rgba(142, 197, 185, 0.2);
}

.countdown-after_work {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.12) 0%, rgba(255, 165, 0, 0.06) 100%);
  border: 1px solid rgba(255, 215, 0, 0.2);
}

.countdown-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
}

.countdown-icon-rest {
  background: linear-gradient(135deg, #FFB5A9 0%, #FF9A8B 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 181, 169, 0.4);
}

.countdown-icon-work {
  background: rgba(255, 255, 255, 0.2);
}

.countdown-icon-after {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.4);
}

.countdown-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.countdown-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

.countdown-working .countdown-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-variant-numeric: tabular-nums;
}

.countdown-title-rest {
  color: #FF9A8B;
}

.countdown-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.countdown-working .countdown-desc {
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 加载容器 - 优化 ===== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 32rpx;
  gap: 48rpx;
}

.loading-spinner-wrapper {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 5rpx solid rgba(142, 197, 185, 0.15);
  border-top-color: var(--primary-start);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-spinner-dot {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: var(--primary-start);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform-origin: 0 0;
  animation: orbit 1s linear infinite;
}

@keyframes orbit {
  from {
    transform: translate(50%, -50%) rotate(0deg) translateX(44rpx) rotate(0deg);
  }
  to {
    transform: translate(50%, -50%) rotate(360deg) translateX(44rpx) rotate(-360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ===== 错误容器 - 优化 ===== */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 32rpx;
  gap: 32rpx;
}

.error-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 107, 129, 0.15) 0%, rgba(244, 67, 54, 0.08) 100%);
}

.error-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* ===== 治愈卡片 - 全新设计 ===== */
.healing-card-wrapper {
  margin-bottom: 40rpx;
  animation: cardEnter 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes cardEnter {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.healing-card {
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  padding: 0;
  box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(142, 197, 185, 0.08);
}

/* 卡片顶部装饰 */
.card-top-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg,
    var(--primary-start) 0%,
    var(--primary-end) 50%,
    var(--accent-pink) 100%);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 24rpx;
  gap: 24rpx;
}

.date-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.1) 0%, rgba(111, 169, 154, 0.05) 100%);
  border-radius: var(--radius-full);
  border: 1px solid rgba(142, 197, 185, 0.1);
}

.date-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.healing-badge {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--surface-white);
  box-shadow: 0 4rpx 16rpx rgba(142, 197, 185, 0.35);
}

.card-content {
  padding: 24rpx 48rpx 48rpx;
  position: relative;
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quote-decoration {
  position: absolute;
  top: 16rpx;
  left: 32rpx;
  font-size: 120rpx;
  font-family: Georgia, serif;
  color: rgba(142, 197, 185, 0.08);
  line-height: 1;
  pointer-events: none;
}

.healing-text {
  font-size: 36rpx;
  line-height: 2;
  color: var(--text-primary);
  text-align: center;
  font-weight: 500;
  word-break: break-all;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.02);
}

.card-footer {
  display: flex;
  justify-content: center;
  padding: 0 40rpx 40rpx;
}

.category-tag {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.12) 0%, rgba(111, 169, 154, 0.06) 100%);
  border-radius: var(--radius-full);
  border: 1px solid rgba(142, 197, 185, 0.15);
}

.category-tag text {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

/* ===== 操作按钮 - 全新设计 ===== */
.action-buttons-wrapper {
  margin-bottom: 32rpx;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx;
  background: var(--surface-white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  transition: all var(--transition-base);
  gap: 16rpx;
  border: 1px solid rgba(142, 197, 185, 0.08);
  position: relative;
  overflow: hidden;
}

.action-btn::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%) scaleX(0);
  width: 60%;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary-start), var(--primary-end));
  border-radius: var(--radius-full) var(--radius-full) 0 0;
  transition: transform var(--transition-base);
}

.action-btn:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-sm);
}

.action-btn:active::before {
  transform: translateX(-50%) scaleX(1);
}

.action-btn.favorited {
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.1) 0%, rgba(111, 169, 154, 0.05) 100%);
  border-color: rgba(142, 197, 185, 0.25);
}

.action-btn.favorited::before {
  background: linear-gradient(90deg, var(--accent-coral), var(--accent-pink));
}

.action-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  border-radius: 50%;
  transition: all var(--transition-bounce);
}

.action-btn:active .action-icon-wrapper {
  transform: scale(1.1);
}

.action-btn.favorited .action-icon-wrapper {
  background: linear-gradient(135deg, rgba(255, 107, 129, 0.2) 0%, rgba(244, 67, 54, 0.1) 100%);
}

.action-text {
  font-size: 26rpx;
  color: #8EC5B9;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.action-btn.favorited .action-text {
  color: #FF6B81;
}

/* ===== 换一换区域 - 全新设计 ===== */
.refresh-section {
  display: flex;
  justify-content: center;
}

.refresh-btn-wrapper {
  position: relative;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 56rpx;
  background: var(--surface-white);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(142, 197, 185, 0.15);
  transition: all var(--transition-base);
  position: relative;
  overflow: hidden;
}

.refresh-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.08) 0%, rgba(111, 169, 154, 0.04) 100%);
  opacity: 0;
  transition: opacity var(--transition-base);
  border-radius: var(--radius-full);
}

.refresh-btn:active::before {
  opacity: 1;
}

.refresh-btn:active {
  transform: scale(0.95);
  box-shadow: var(--shadow-sm);
}

.refresh-btn text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-dark);
  position: relative;
  z-index: 1;
}

/* ===== 动画 ===== */
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ===== 响应式适配 ===== */
@media (min-width: 768px) {
  .healing-card {
    max-width: 640rpx;
    margin: 0 auto;
  }

  .action-buttons {
    max-width: 560rpx;
    margin: 0 auto;
  }

  .header-title {
    font-size: 44rpx;
  }
}
