<!--pages/index/index.wxml - 首页重新设计-->
<view class="page">
  <!-- 装饰背景 -->
  <view class="bg-gradient"></view>
  <view class="bg-decoration bg-deco-1"></view>
  <view class="bg-decoration bg-deco-2"></view>

  <!-- 头部 -->
  <view class="header">
    <view class="header-content">
      <view class="brand-badge">
        <t-icon name="lightbulb-circle" size="40rpx" color="#8EC5B9"></t-icon>
        <text class="brand-title">打工人治愈所</text>
      </view>
    </view>
    <text class="header-subtitle">给忙碌的你一份小确幸</text>
  </view>

  <!-- 主内容区域 -->
  <view class="main-content">

    <!-- 下班倒计时卡片 -->
    <view class="countdown-card-wrapper">
      <!-- 未设置 -->
      <view class="countdown-card countdown-not-configured" wx:if="{{countdownState === 'not_configured'}}" bindtap="goToSchedule">
        <view class="countdown-icon-box">
          <t-icon name="time" size="40rpx" color="#8EC5B9"></t-icon>
        </view>
        <view class="countdown-info">
          <text class="countdown-title">设置上下班时间</text>
          <text class="countdown-desc">开启下班倒计时提醒</text>
        </view>
        <t-icon name="chevron-right" size="32rpx" color="#CCCCCC"></t-icon>
      </view>

      <view class="countdown-card countdown-rest" wx:elif="{{countdownState === 'rest_day'}}" bindtap="goToSchedule">
        <view class="countdown-icon-box countdown-icon-rest">
          <t-icon name="star-filled" size="40rpx" color="#FFFFFF"></t-icon>
        </view>
        <view class="countdown-info">
          <text class="countdown-title countdown-title-rest">{{countdownText}}</text>
        </view>
      </view>

      <view class="countdown-card countdown-{{countdownState}}" wx:else bindtap="goToSchedule">
        <view class="countdown-icon-box {{countdownState === 'after_work' ? 'countdown-icon-after' : 'countdown-icon-work'}}">
          <t-icon name="{{countdownState === 'before_work' ? 'sunrise' : (countdownState === 'after_work' ? 'sunset' : 'time')}}" size="40rpx" color="#FFFFFF"></t-icon>
        </view>
        <view class="countdown-info">
          <text class="countdown-title">{{countdownText}}</text>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <block wx:if="{{loading}}">
      <view class="loading-container">
        <view class="loading-spinner-wrapper">
          <view class="loading-spinner"></view>
          <view class="loading-spinner-dot"></view>
        </view>
        <text class="loading-text">正在加载今日治愈...</text>
      </view>
    </block>

    <!-- 错误状态 -->
    <block wx:elif="{{error}}">
      <view class="error-container">
        <view class="error-icon-wrapper">
          <t-icon name="error-circle" size="80rpx" color="#FF6B81"></t-icon>
        </view>
        <text class="error-text">加载失败，请稍后重试</text>
        <button class="btn btn-primary" bindtap="loadDailyContent">重新加载</button>
      </view>
    </block>

    <!-- 治愈卡片 -->
    <block wx:else>
      <view class="healing-card-wrapper">
        <view class="healing-card">
          <!-- 卡片顶部装饰 -->
          <view class="card-top-decoration"></view>

          <!-- 卡片头部 -->
          <view class="card-header">
            <view class="date-badge">
              <t-icon name="calendar" size="32rpx" color="#8EC5B9"></t-icon>
              <text class="date-text">{{todayDate}}</text>
            </view>
            <view class="healing-badge">
              <text>今日治愈</text>
            </view>
          </view>

          <!-- 卡片内容 -->
          <view class="card-content">
            <view class="quote-decoration">"</view>
            <text class="healing-text">{{dailyContent.content}}</text>
          </view>

          <!-- 卡片底部 -->
          <view class="card-footer">
            <view class="category-tag">
              <text>{{dailyContent.category || '治愈'}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 操作栏 -->
      <view class="action-bar">
        <view class="action-bar__left">
          <view class="action-bar__btn {{isFavorited ? 'action-bar__btn--active' : ''}}" bindtap="toggleFavorite">
            <t-icon name="{{isFavorited ? 'heart-filled' : 'heart'}}" size="32rpx" color="{{isFavorited ? '#FF6B81' : '#8EC5B9'}}"></t-icon>
            <text class="action-bar__text">{{isFavorited ? '已收藏' : '收藏'}}</text>
          </view>
          <view class="action-bar__btn" bindtap="shareContent">
            <t-icon name="share" size="32rpx" color="#8EC5B9"></t-icon>
            <text class="action-bar__text">分享</text>
          </view>
        </view>
        <view class="action-bar__right" bindtap="loadNextContent">
          <t-icon name="refresh" size="28rpx" color="#8EC5B9"></t-icon>
          <text class="action-bar__text">换一换</text>
        </view>
      </view>

      <!-- 打工人小贴士 -->
      <view class="tip-card">
        <view class="tip-card__accent"></view>
        <view class="tip-card__body">
          <view class="tip-card__header">
            <view class="tip-card__icon">
              <t-icon name="star-filled" size="22rpx" color="#FFB347"></t-icon>
            </view>
            <text class="tip-card__title">打工人小贴士</text>
          </view>
          <text class="tip-card__content">{{todayTip}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
