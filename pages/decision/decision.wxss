/* pages/decision/decision.wxss - 决策转盘 */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #e8ecf1 100%);
  position: relative;
}

/* ===== 自定义导航栏 ===== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88px;
  padding-top: var(--status-bar-height, 20px);
  background-color: #8EC5B9;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  padding-bottom: 0;
}

.navbar-inner {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.navbar-back {
  position: absolute;
  left: 16rpx;
  display: flex;
  align-items: center;
  padding: 8rpx;
  z-index: 10;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* ===== 内容区域 ===== */
.content-scroll {
  height: 100vh;
  padding-top: 88px;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 头部区域 ===== */
.header-section {
  padding: 40rpx 32rpx 32rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #8EC5B9;
  line-height: 1.2;
}

.header-subtitle {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* ===== 转盘展示区域 ===== */
.turntable-section {
  padding: 0 32rpx 32rpx;
}

.turntable-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 12rpx 48rpx rgba(142, 197, 185, 0.15);
  border: 1rpx solid rgba(142, 197, 185, 0.1);
  position: relative;
  z-index: 1;
}

/* 指针包装器 - 正常文档流 */
.pointer-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 48rpx;
  margin-bottom: -16rpx;
  position: relative;
  z-index: 20;
}

.pointer {
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 40rpx solid #ff4757;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

.turntable-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  background: linear-gradient(180deg, #f8f9ff 0%, #f0f2ff 100%);
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  box-shadow: inset 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.turntable-body {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.turntable-segments {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
}

.turntable-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  z-index: 10;
}

.turntable-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.turntable-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.turntable-count {
  font-size: 26rpx;
  color: #999;
}

.turntable-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #f5f7fa;
  color: #666;
  border: none;
}

.action-btn text {
  display: flex;
  align-items: center;
}

.action-btn.primary {
  background: linear-gradient(135deg, #8ec5b9 0%, #6f9a8e 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(142, 197, 185, 0.35);
}

.action-btn.primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* ===== 列表区域 ===== */
.list-section {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.icon-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background-color: #8EC5B9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.section-count {
  font-size: 26rpx;
  color: #999;
}

.turntable-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.turntable-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.turntable-item.active {
  border-color: rgba(142, 197, 185, 0.3);
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.05) 0%, rgba(111, 154, 142, 0.05) 100%);
}

.item-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.item-tags {
  display: flex;
  gap: 16rpx;
}

.item-tag {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.item-actions {
  display: flex;
  gap: 16rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f7fa;
  transition: all 0.2s ease;
}

.icon-btn:active {
  background: #e8ecf1;
}

.icon-btn.delete:active {
  background: rgba(245, 87, 108, 0.1);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 100rpx 0;
}

.empty-icon {
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
}

/* ===== 占位空间 ===== */
.spacer {
  height: 40rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.98) 100%);
  backdrop-filter: blur(20rpx);
  z-index: 100;
}

.bar-btn {
  flex: 1;
  height: 108rpx;
  border-radius: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: #ffffff;
  color: #666;
  border: 2rpx solid #e8ecf1;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.bar-btn text {
  display: flex;
  align-items: center;
}

.bar-btn[disabled] {
  opacity: 0.4;
}

.bar-btn.disabled {
  opacity: 0.4;
}

/* ===== 结果弹窗 ===== */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-modal.hide {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.result-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

.result-content {
  position: relative;
  width: 600rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.2);
  animation: resultPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  z-index: 1;
}

@keyframes resultPop {
  from {
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0;
  }
  to {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

.result-animate {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.result-icon-box {
  margin-bottom: 16rpx;
}

.result-label {
  font-size: 28rpx;
  color: #999;
}

.result-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #8ec5b9;
  text-align: center;
  word-break: break-all;
  line-height: 1.3;
}

.result-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #8ec5b9 0%, #6f9a8e 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(142, 197, 185, 0.35);
}
