<!--pages/toolkit/toolkit.wxml-->
<view class="page">
  <!-- 装饰背景 -->
  <view class="bg-decoration"></view>
  <view class="bg-decoration-2"></view>

  <!-- 头部 -->
  <view class="header">
    <text class="header-subtitle">打工必备，让工作更高效、更轻松～</text>
  </view>

  <!-- 工具列表 -->
  <view class="tools-container">

    <!-- 效率工具 -->
    <view class="section">
      <view class="section-header">
        <view class="section-dot"></view>
        <text class="section-label">效率工具</text>
      </view>
      <view class="bento-row">
        <view class="bento-card" bindtap="goToQRCode" style="animation-delay: 0.05s">
          <view class="bento-icon bg-mint">
            <t-icon name="scan" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">二维码生成</text>
          <text class="bento-desc">文本生成二维码</text>
        </view>
        <view class="bento-card" bindtap="goToImage2Pdf" style="animation-delay: 0.1s">
          <view class="bento-icon bg-sage">
            <t-icon name="file-image" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">图片转 PDF</text>
          <text class="bento-desc">快速转换文档</text>
        </view>
      </view>
      <view class="bento-row" style="margin-top: 16rpx">
        <view class="bento-card" bindtap="goToImageCompressor" style="animation-delay: 0.15s">
          <view class="bento-icon bg-teal">
            <t-icon name="image-off" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">图片压缩</text>
          <text class="bento-desc">智能压缩保持清晰</text>
        </view>
        <view class="bento-card" bindtap="goToGridCutter" style="animation-delay: 0.2s">
          <view class="bento-icon bg-orange">
            <t-icon name="component-grid-filled" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">九宫格切图</text>
          <text class="bento-desc">朋友圈九宫格</text>
        </view>
      </view>
      <view class="bento-row" style="margin-top: 16rpx">
        <view class="bento-card" bindtap="goToImageEditor" style="animation-delay: 0.25s">
          <view class="bento-icon bg-mint">
            <t-icon name="edit" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">图片编辑</text>
          <text class="bento-desc">滤镜裁剪调色</text>
        </view>
        <view class="bento-card" bindtap="goToWatermark" style="animation-delay: 0.3s">
          <view class="card-badge">NEW</view>
          <view class="bento-icon bg-sage">
            <t-icon name="view-image" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">图片水印</text>
          <text class="bento-desc">版权保护</text>
        </view>
      </view>
      <view class="bento-row" style="margin-top: 16rpx">
        <view class="bento-card" bindtap="goToWatermarkRemove" style="animation-delay: 0.35s">
          <view class="card-badge">NEW</view>
          <view class="bento-icon bg-teal">
            <t-icon name="tape" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">去水印</text>
          <text class="bento-desc">涂抹去除水印</text>
        </view>
      </view>
    </view>

    <!-- 趣味互动 -->
    <view class="section">
      <view class="section-header">
        <view class="section-dot dot-amber"></view>
        <text class="section-label">趣味互动</text>
      </view>
      <view class="bento-row">
        <view class="bento-card" bindtap="goToLedDisplay" style="animation-delay: 0.2s">
          <view class="bento-icon bg-violet">
            <t-icon name="browse-off" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">LED 弹幕</text>
          <text class="bento-desc">演唱会应援</text>
        </view>
        <view class="bento-card" bindtap="goToDecision" style="animation-delay: 0.25s">
          <view class="bento-icon bg-amber">
            <t-icon name="play-circle" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">决策转盘</text>
          <text class="bento-desc">聚会游戏</text>
        </view>
      </view>
    </view>

    <!-- 签名安全 -->
    <view class="section">
      <view class="section-header">
        <view class="section-dot dot-rose"></view>
        <text class="section-label">签名安全</text>
      </view>
      <view class="bento-row">
        <view class="bento-card" bindtap="goToVault" style="animation-delay: 0.3s">
          <view class="bento-icon bg-rose">
            <t-icon name="lock-on" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">绝密保险箱</text>
          <text class="bento-desc">加密安全分享</text>
        </view>
        <view class="bento-card" bindtap="goToSignature" style="animation-delay: 0.35s">
          <view class="bento-icon bg-sky">
            <t-icon name="edit-1" size="40rpx" color="#fff"></t-icon>
          </view>
          <text class="bento-name">电子签名</text>
          <text class="bento-desc">手写签名保存</text>
        </view>
      </view>
    </view>

  </view>
</view>
