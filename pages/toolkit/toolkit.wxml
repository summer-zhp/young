<!--pages/toolkit/toolkit.wxml-->
<view class="page">
  <!-- 装饰背景 -->
  <view class="bg-decoration"></view>

  <!-- 头部 -->
  <view class="header">
    <view class="header-content">
      <!-- <text class="header-title">工具箱</text> -->
      <text class="header-subtitle">打工必备，让我们的工作更高效、更轻松～</text>
    </view>
  </view>

  <!-- 工具列表 -->
  <view class="tools-container">
    <view class="tools-grid">
      <!-- 朋友圈配图 -->
      <view class="tool-card" wx:if="{{showCaptionImage}}" bindtap="goToCaptionImage">
        <view class="tool-card-inner">
          <view class="tool-icon-wrapper">
            <view class="tool-icon-bg"></view>
            <view class="tool-icon-tcb">
              <t-icon name="image" size="48rpx" color="#8EC5B9"></t-icon>
            </view>
          </view>
          <view class="tool-info">
            <text class="tool-name">朋友圈配图</text>
            <text class="tool-desc">一键生成朋友圈文案场景图</text>
          </view>
          <view class="tool-arrow">
            <t-icon name="chevron-right" size="32rpx" color="#9A9A9A"></t-icon>
          </view>
        </view>
      </view>

      <!-- 二维码生成 -->
      <view class="tool-card" bindtap="goToQRCode">
        <view class="tool-card-inner">
          <view class="tool-icon-wrapper">
            <view class="tool-icon-bg"></view>
            <view class="tool-icon-tcb">
              <t-icon name="scan" size="48rpx" color="#8EC5B9"></t-icon>
            </view>
          </view>
          <view class="tool-info">
            <text class="tool-name">二维码生成</text>
            <text class="tool-desc">文本内容一键生成二维码</text>
          </view>
          <view class="tool-arrow">
            <t-icon name="chevron-right" size="32rpx" color="#9A9A9A"></t-icon>
          </view>
        </view>
      </view>

      <!-- 图片转 PDF -->
      <view class="tool-card" bindtap="goToImage2Pdf">
        <view class="tool-card-inner">
          <view class="tool-icon-wrapper">
            <view class="tool-icon-bg"></view>
            <view class="tool-icon-tcb">
              <t-icon name="file-image" size="48rpx" color="#8EC5B9"></t-icon>
            </view>
          </view>
          <view class="tool-info">
            <text class="tool-name">图片转 PDF</text>
            <text class="tool-desc">将图片快速转换为 PDF 文档</text>
          </view>
          <view class="tool-arrow">
            <t-icon name="chevron-right" size="32rpx" color="#9A9A9A"></t-icon>
          </view>
        </view>
      </view>

      <!-- 图片压缩 -->
      <view class="tool-card" bindtap="goToImageCompressor">
        <view class="tool-card-inner">
          <view class="tool-icon-wrapper">
            <view class="tool-icon-bg"></view>
            <view class="tool-icon-tcb">
              <t-icon name="image-off" size="48rpx" color="#8EC5B9"></t-icon>
            </view>
          </view>
          <view class="tool-info">
            <text class="tool-name">图片压缩</text>
            <text class="tool-desc">智能压缩图片大小，保持清晰度</text>
          </view>
          <view class="tool-arrow">
            <t-icon name="chevron-right" size="32rpx" color="#9A9A9A"></t-icon>
          </view>
        </view>
      </view>

      <!-- LED 手持弹幕 -->
      <view class="tool-card" bindtap="goToLedDisplay">
        <view class="tool-card-inner">
          <view class="tool-icon-wrapper">
            <view class="tool-icon-bg"></view>
            <view class="tool-icon-tcb">
              <t-icon name="browse-off" size="48rpx" color="#8EC5B9"></t-icon>
            </view>
          </view>
          <view class="tool-info">
            <text class="tool-name">LED 手持弹幕</text>
            <text class="tool-desc">演唱会应援/机场接机/活动氛围</text>
          </view>
          <view class="tool-arrow">
            <t-icon name="chevron-right" size="32rpx" color="#9A9A9A"></t-icon>
          </view>
        </view>
      </view>

      <!-- 决策转盘 -->
      <view class="tool-card" bindtap="goToDecision">
        <view class="tool-card-inner">
          <view class="tool-icon-wrapper">
            <view class="tool-icon-bg"></view>
            <view class="tool-icon-tcb">
              <t-icon name="play-circle" size="48rpx" color="#8EC5B9"></t-icon>
            </view>
          </view>
          <view class="tool-info">
            <text class="tool-name">决策转盘</text>
            <text class="tool-desc">选择困难症/聚会游戏/课堂提问</text>
          </view>
          <view class="tool-arrow">
            <t-icon name="chevron-right" size="32rpx" color="#9A9A9A"></t-icon>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>