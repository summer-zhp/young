<!--pages/toolkit/grid-cutter/grid-cutter - 九宫格切图-->
<view class="page">
  <view class="content">

    <!-- 选图区域 -->
    <view class="pick-area" wx:if="{{!imageUrl}}" bindtap="chooseImage">
      <view class="pick-box">
        <t-icon name="image" size="72rpx" color="#8EC5B9"></t-icon>
        <text class="pick-text">选择图片</text>
        <text class="pick-hint">建议选择正方形图片效果更佳</text>
      </view>
    </view>

    <!-- 预览区域 -->
    <view class="preview-section" wx:if="{{imageUrl && !resultImages.length}}">
      <view class="section-header">
        <text class="section-title">预览</text>
        <text class="change-btn" bindtap="chooseImage">更换图片</text>
      </view>
      <view class="preview-wrapper">
        <image class="preview-image" src="{{imageUrl}}" mode="aspectFill"></image>
        <view class="grid-overlay">
          <view class="grid-line grid-h1"></view>
          <view class="grid-line grid-h2"></view>
          <view class="grid-line grid-v1"></view>
          <view class="grid-line grid-v2"></view>
        </view>
      </view>
      <view class="crop-info" wx:if="{{cropInfo}}">
        <t-icon name="info-circle" size="24rpx" color="#999"></t-icon>
        <text>{{cropInfo}}</text>
      </view>
      <button class="cut-btn" bindtap="startCut" loading="{{cutting}}">
        <t-icon name="scan" size="36rpx" color="#fff"></t-icon>
        <text>开始切图</text>
      </button>
    </view>

    <!-- 切图结果 -->
    <view class="result-section" wx:if="{{resultImages.length > 0}}">
      <view class="section-header">
        <text class="section-title">切图完成</text>
        <text class="change-btn" bindtap="resetAll">重新选择</text>
      </view>
      <view class="result-grid">
        <view class="result-cell" wx:for="{{resultImages}}" wx:key="index">
          <image class="result-image" src="{{item}}" mode="aspectFill"></image>
        </view>
      </view>
      <button class="save-btn" bindtap="saveAll" loading="{{saving}}" disabled="{{saving}}">
        <t-icon name="download" size="36rpx" color="#fff"></t-icon>
        <text>一键保存到相册</text>
      </button>
      <view class="save-tip">
        <text>共 9 张图片，保存后按顺序选择即可拼成九宫格</text>
      </view>
    </view>

  </view>

  <!-- 隐藏的 Canvas -->
  <canvas type="2d" id="cutCanvas" class="cut-canvas"></canvas>
</view>
