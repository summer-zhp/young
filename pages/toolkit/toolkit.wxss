/* pages/toolkit/toolkit.wxss */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

/* ===== 装饰背景 ===== */
.bg-decoration {
  position: absolute;
  top: -150rpx;
  right: -150rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.12) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.bg-decoration-2 {
  position: absolute;
  bottom: 100rpx;
  left: -120rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

/* ===== 头部 ===== */
.header {
  padding: 32rpx 40rpx 12rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ===== 工具容器 ===== */
.tools-container {
  flex: 1;
  padding: 12rpx 32rpx 48rpx;
  position: relative;
  z-index: 1;
}

/* ===== 分区 ===== */
.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8EC5B9;
}

.dot-amber {
  background: #E5B87A;
}

.dot-rose {
  background: #D4899A;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

/* ===== Bento 网格行 ===== */
.bento-row {
  display: flex;
  gap: 16rpx;
}

/* ===== Bento 卡片 (网格) ===== */
.bento-card {
  flex: 1;
  background: var(--surface-white);
  border-radius: 24rpx;
  padding: 28rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(142, 197, 185, 0.06);
  position: relative;
  transition: all 0.2s;
  opacity: 0;
  animation: cardFadeIn 0.4s ease-out forwards;
}

.bento-card:active {
  transform: scale(0.96);
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* ===== 全宽卡片 ===== */
.bento-wide {
  display: flex;
  align-items: center;
  background: var(--surface-white);
  border-radius: 24rpx;
  padding: 22rpx 28rpx;
  margin-top: 16rpx;
  gap: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(142, 197, 185, 0.06);
  opacity: 0;
  animation: cardFadeIn 0.4s ease-out forwards;
}

.bento-wide:active {
  transform: scale(0.98);
}

.bento-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* ===== 图标圆 ===== */
.bento-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ===== 图标渐变色 ===== */
.bg-mint { background: linear-gradient(135deg, #8EC5B9, #7AB3A7); }
.bg-sage { background: linear-gradient(135deg, #7BA89E, #6A978D); }
.bg-teal { background: linear-gradient(135deg, #A8D5CC, #8EC5B9); }
.bg-violet { background: linear-gradient(135deg, #B8A9D4, #A596C5); }
.bg-amber { background: linear-gradient(135deg, #E5B87A, #D4A76A); }
.bg-sky { background: linear-gradient(135deg, #7BBFC5, #6AAEB4); }
.bg-rose { background: linear-gradient(135deg, #D4899A, #C37888); }

/* ===== 文字 ===== */
.bento-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
}

.bento-wide .bento-name {
  text-align: left;
}

.bento-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: center;
}

.bento-wide .bento-desc {
  text-align: left;
}

/* ===== NEW 角标 ===== */
.card-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: linear-gradient(135deg, #FF6B81, #F5576C);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}

/* ===== 动画 ===== */
@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
