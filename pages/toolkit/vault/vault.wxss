/* pages/toolkit/vault/vault.wxss - 绝密保险箱 */
@import '../../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  position: relative;
}

/* ===== 导航栏 ===== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88px;
  padding-top: var(--status-bar-height, 20px);
  background-color: #8EC5B9;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  padding-bottom: 0;
}

.navbar-inner {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.navbar-back {
  position: absolute;
  left: 16rpx;
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ===== 内容区域 ===== */
.content-scroll {
  height: 100vh;
  padding-top: 88px;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== Tab 切换 ===== */
.tab-bar {
  display: flex;
  margin: 24rpx 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 6rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
  transition: all 0.2s;
}

.tab-item.active {
  background: linear-gradient(135deg, #8EC5B9 0%, #6f9a8e 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(142, 197, 185, 0.3);
}

/* ===== 密件列表 ===== */
.secret-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.secret-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(142, 197, 185, 0.08);
}

.secret-main {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  gap: 20rpx;
}

.secret-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(142, 197, 185, 0.1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.secret-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.secret-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.secret-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.secret-actions {
  display: flex;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.secret-actions .action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 18rpx 0;
  font-size: 24rpx;
}

.copy-btn {
  color: var(--primary-start);
}

.delete-btn {
  color: #f5576c;
  border-left: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
}

/* ===== 解密区域 ===== */
.decrypt-section {
  padding: 0 32rpx;
}

.section-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.card-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.decrypt-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.key-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 80rpx 0 20rpx;
  box-sizing: border-box;
}

.key-row {
  position: relative;
}

.key-row .key-form-input {
  padding-right: 80rpx;
}

.key-toggle {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 8rpx;
}

.decrypt-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #8EC5B9 0%, #6f9a8e 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(142, 197, 185, 0.35);
}

.decrypt-btn[disabled] {
  opacity: 0.4;
  box-shadow: none;
}

.decrypt-btn:active {
  transform: scale(0.98);
}

/* ===== 浮动按钮 ===== */
.fab-btn {
  position: fixed;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8EC5B9 0%, #6f9a8e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(142, 197, 185, 0.5);
  z-index: 50;
}

.fab-btn:active {
  transform: scale(0.92);
}

/* ===== 弹窗通用 ===== */
.modal {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal.hide {
  display: none;
}

.modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}

.modal-content {
  position: relative;
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 1;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  padding: 8rpx;
}

/* ===== 表单 ===== */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* ===== 查看内容 ===== */
.view-content {
  max-height: 500rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.view-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
  word-break: break-all;
}

/* ===== 弹窗按钮 ===== */
.modal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #8EC5B9 0%, #6f9a8e 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(142, 197, 185, 0.35);
}

.modal-btn[disabled] {
  opacity: 0.4;
  box-shadow: none;
}

/* ===== 占位 ===== */
.spacer {
  height: 40rpx;
}
