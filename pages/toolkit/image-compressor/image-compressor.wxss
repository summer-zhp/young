/* pages/toolkit/image-compressor/image-compressor.wxss */
@import '../../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #e8f5f3 100%);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow-x: hidden;
}

/* ===== 装饰背景 ===== */
.decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.decoration-1 {
  top: -100rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.15) 0%, transparent 70%);
  animation: float 8s ease-in-out infinite;
}

.decoration-2 {
  top: 40%;
  left: -120rpx;
  width: 250rpx;
  height: 250rpx;
  background: radial-gradient(circle, rgba(255, 181, 169, 0.12) 0%, transparent 70%);
  animation: float 10s ease-in-out reverse;
}

.decoration-3 {
  bottom: 20%;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.1) 0%, transparent 70%);
  animation: float 12s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  33% {
    transform: translate(20rpx, -25rpx) scale(1.03);
  }
  66% {
    transform: translate(-15rpx, 15rpx) scale(0.97);
  }
}

/* ===== 头部区域 ===== */
.header {
  padding: 40rpx 40rpx 24rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.title-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  padding: 14rpx 28rpx;
  border-radius: var(--radius-full);
  border: 1px solid rgba(142, 197, 185, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(142, 197, 185, 0.15);
}

.title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #6f9a8e 0%, #8ec5b9 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ===== 主内容区域 ===== */
.main-content {
  padding: 0 32rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* ===== 选择图片卡片 ===== */
.select-card {
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  padding: 36rpx 32rpx;
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.05);
  border: 1px solid rgba(142, 197, 185, 0.1);
}

.select-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.select-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.upload-area {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-lg);
  border: 2rpx dashed rgba(142, 197, 185, 0.3);
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.03) 0%, rgba(111, 169, 154, 0.02) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-base);
  overflow: hidden;
}

.upload-area:active {
  border-color: rgba(142, 197, 185, 0.5);
  background: rgba(142, 197, 185, 0.08);
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.upload-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.image-info {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx;
  background: rgba(142, 197, 185, 0.05);
  border-radius: var(--radius-md);
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.info-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 600;
}

/* ===== 压缩设置卡片 ===== */
.settings-card {
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  padding: 36rpx 32rpx;
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.05);
  border: 1px solid rgba(142, 197, 185, 0.1);
}

.settings-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.settings-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.setting-item {
  margin-bottom: 32rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.setting-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.setting-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.quality-slider {
  margin-bottom: 12rpx;
}

.quality-tips {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
}

.tip-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.size-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.size-option {
  padding: 20rpx 16rpx;
  border-radius: var(--radius-lg);
  border: 2rpx solid rgba(142, 197, 185, 0.2);
  background: rgba(142, 197, 185, 0.03);
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all var(--transition-base);
}

.size-option:active {
  transform: scale(0.95);
}

.size-option.active {
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  border-color: rgba(142, 197, 185, 0.4);
}

.size-option-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.size-option.active .size-option-text {
  color: var(--primary-dark);
  font-weight: 600;
}

/* ===== 压缩按钮 ===== */
.compress-section {
  padding: 12rpx 0;
}

.compress-btn {
  width: 100%;
  height: 100rpx;
  border-radius: var(--radius-2xl);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #cccccc 0%, #b0b0b0 100%);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
  transition: all var(--transition-base);
  border: none;
}

.compress-btn.active {
  background: linear-gradient(135deg, #8ec5b9 0%, #6f9a8e 100%);
  box-shadow: 0 8rpx 32rpx rgba(142, 197, 185, 0.4);
}

.compress-btn.active:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(142, 197, 185, 0.3);
}

.compress-btn[disabled] {
  opacity: 0.6;
}

.compress-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* ===== 结果卡片 ===== */
.result-card {
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  padding: 36rpx 32rpx;
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.05);
  border: 1px solid rgba(142, 197, 185, 0.15);
  animation: resultFadeIn 0.5s ease-out;
}

@keyframes resultFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.result-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-title text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ===== 对比信息 ===== */
.comparison {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.05) 0%, rgba(111, 169, 154, 0.03) 100%);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
}

.comparison-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.comparison-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.comparison-size {
  font-size: 28rpx;
  font-weight: 700;
}

.comparison-size.before {
  color: var(--text-secondary);
}

.comparison-size.after {
  color: #52c41a;
}

.comparison-rate {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.comparison-arrow {
  display: flex;
  align-items: center;
}

/* ===== 预览图片 ===== */
.image-preview-wrapper {
  display: flex;
  justify-content: center;
  padding: 16rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.03) 0%, rgba(111, 169, 154, 0.02) 100%);
  border-radius: var(--radius-xl);
  border: 2rpx solid rgba(142, 197, 185, 0.15);
  margin-bottom: 24rpx;
}

.compressed-image {
  width: 100%;
  max-height: 600rpx;
  border-radius: var(--radius-md);
}

/* ===== 操作按钮 ===== */
.result-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1px solid rgba(142, 197, 185, 0.1);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-lg);
  transition: all var(--transition-base);
}

.action-btn:active {
  background: rgba(142, 197, 185, 0.1);
  transform: scale(0.95);
}

.action-btn text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* ===== 隐藏 Canvas ===== */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 2000px;
  height: 2000px;
}
