/* pages/toolkit/signature/signature.wxss - 电子签名 */
@import '../../../styles/theme.wxss';

.page {
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, #f0f2f5 0%, #e4e8ed 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 顶部工具栏 ===== */
.top-bar {
  display: flex;
  align-items: center;
  padding: 4rpx 16rpx;
  padding-left: calc(16rpx + env(safe-area-inset-left));
  padding-right: calc(16rpx + env(safe-area-inset-right));
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  z-index: 10;
  flex-shrink: 0;
  gap: 10rpx;
}

.btn-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.btn-icon:active {
  background: rgba(0, 0, 0, 0.08);
}

.page-title {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

.divider {
  width: 1rpx;
  height: 22rpx;
  background: rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.tool-group {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

/* 颜色选择 */
.color-item {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid transparent;
}

.color-item.active {
  border-color: var(--primary-start);
  background: rgba(142, 197, 185, 0.1);
}

.color-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.12);
}

/* 粗细选择 */
.width-item {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid transparent;
}

.width-item.active {
  border-color: var(--primary-start);
  background: rgba(142, 197, 185, 0.1);
}

.width-dot {
  border-radius: 50%;
  background: var(--text-primary);
}

.width-dot.s { width: 5rpx; height: 5rpx; }
.width-dot.m { width: 9rpx; height: 9rpx; }
.width-dot.l { width: 14rpx; height: 14rpx; }

/* ===== 画布区域 ===== */
.canvas-wrapper {
  flex: 1;
  padding: 8rpx 12rpx;
  position: relative;
  min-height: 0;
}

.signature-canvas {
  background: #ffffff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06), 0 0 0 1rpx rgba(0, 0, 0, 0.04);
}

/* 空态提示 */
.canvas-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 6rpx;
  pointer-events: none;
  z-index: 5;
}

.hint-text {
  font-size: 18rpx;
  color: #c8c8c8;
  letter-spacing: 2rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 16rpx;
  padding-left: calc(16rpx + env(safe-area-inset-left));
  padding-right: calc(16rpx + env(safe-area-inset-right));
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  z-index: 10;
  flex-shrink: 0;
}

.bar-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 40rpx;
  background: rgba(0, 0, 0, 0.04);
}

.action-btn text {
  font-size: 16rpx;
  color: #666;
}

.action-btn:active {
  background: rgba(0, 0, 0, 0.08);
}

.save-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-dark) 100%);
  box-shadow: 0 2rpx 12rpx rgba(142, 197, 185, 0.4);
}

.save-btn text {
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
}

.save-btn:active {
  box-shadow: 0 1rpx 8rpx rgba(142, 197, 185, 0.3);
}
