<!--pages/toolbox/toolbox.wxml - 放松室页面重新设计-->
<view class="page">
  <!-- 装饰背景 -->
  <view class="blob blob-1"></view>
  <view class="blob blob-2"></view>

  <!-- 头部 -->
  <view class="header">
    <text class="header-subtitle">选择一种方式，给自己充充电~</text>
  </view>

  <!-- 推荐卡片 -->
  <view class="featured-wrap" wx:if="{{featuredTool}}">
    <view class="featured-card" bindtap="goToTool" data-url="{{featuredTool.url}}">
      <view class="featured-deco featured-deco-1"></view>
      <view class="featured-deco featured-deco-2"></view>
      <view class="featured-content">
        <view class="featured-left">
          <text class="featured-tag">推荐体验</text>
          <text class="featured-name">{{featuredTool.name}}</text>
          <text class="featured-desc">{{featuredTool.description}}</text>
        </view>
        <view class="featured-icon-circle">
          <t-icon name="{{featuredTool.icon}}" size="56rpx" color="rgba(255,255,255,0.95)"></t-icon>
        </view>
      </view>
    </view>
  </view>

  <!-- 工具卡片网格 -->
  <view class="tools-grid">
    <view class="grid-card {{item.wide ? 'grid-card-wide' : ''}}" wx:for="{{gridTools}}" wx:key="id"
      bindtap="goToTool" data-url="{{item.url}}"
      style="background: {{item.cardBg}}; animation-delay: {{item.delay}}">
      <view class="grid-icon-circle" style="background: {{item.iconBg}}">
        <t-icon name="{{item.icon}}" size="36rpx" color="#fff"></t-icon>
      </view>
      <view class="grid-text">
        <text class="grid-name" style="color: {{item.nameColor}}">{{item.name}}</text>
        <text class="grid-desc">{{item.description}}</text>
      </view>
      <view wx:if="{{item.isNew}}" class="new-badge">NEW</view>
    </view>
  </view>
</view>
