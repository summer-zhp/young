/* pages/toolbox/toolbox.wxss - 放松室页面重新设计 */
@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

/* ===== 装饰背景 ===== */
.blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.blob-1 {
  top: -180rpx;
  right: -100rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.1) 0%, transparent 70%);
  animation: blobFloat 8s ease-in-out infinite;
}

.blob-2 {
  bottom: 12%;
  left: -120rpx;
  width: 350rpx;
  height: 350rpx;
  background: radial-gradient(circle, rgba(229, 184, 122, 0.07) 0%, transparent 70%);
  animation: blobFloat 10s ease-in-out infinite reverse;
}

@keyframes blobFloat {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  33% {
    transform: translate(20rpx, -20rpx) scale(1.03);
  }
  66% {
    transform: translate(-15rpx, 15rpx) scale(0.97);
  }
}

/* ===== 头部 ===== */
.header {
  padding: 32rpx 40rpx 24rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ===== 推荐卡片 ===== */
.featured-wrap {
  padding: 8rpx 32rpx 28rpx;
  position: relative;
  z-index: 1;
}

.featured-card {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #8EC5B9 0%, #6FA99E 55%, #5E9A8F 100%);
  box-shadow: 0 8rpx 40rpx rgba(142, 197, 185, 0.25);
  opacity: 0;
  animation: featuredIn 0.6s ease-out 0.05s forwards;
}

.featured-card:active {
  transform: scale(0.98);
  transition: transform 0.15s;
}

@keyframes featuredIn {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 推荐卡片装饰圆 */
.featured-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  pointer-events: none;
}

.featured-deco-1 {
  top: -40rpx;
  right: -20rpx;
  width: 180rpx;
  height: 180rpx;
}

.featured-deco-2 {
  bottom: -60rpx;
  right: 80rpx;
  width: 140rpx;
  height: 140rpx;
}

.featured-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 44rpx 40rpx;
}

.featured-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.featured-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.18);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  align-self: flex-start;
  margin-bottom: 6rpx;
}

.featured-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.featured-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 2rpx;
}

.featured-icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 24rpx;
}

/* ===== 工具卡片网格 ===== */
.tools-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx 48rpx;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.grid-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  padding: 32rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  opacity: 0;
  animation: gridCardIn 0.5s ease-out forwards;
  transition: transform 0.2s;
}

.grid-card:active {
  transform: scale(0.96);
}

@keyframes gridCardIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 宽卡片（底部全宽） */
.grid-card-wide {
  width: 100%;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.grid-card-wide .grid-icon-circle {
  margin-bottom: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
}

.grid-card-wide .grid-text {
  flex: 1;
}

/* 图标圆角方块 */
.grid-icon-circle {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

/* 文字区域 */
.grid-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.grid-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.grid-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* NEW 角标 */
.new-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #FF6B81, #F5576C);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}
