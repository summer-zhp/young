/* =====================================
   树洞倾诉页面 - 精美设计
   Style: Soft Healing (柔和治愈)
   ===================================== */
@import '../../styles/theme.wxss';

/* ===== 页面基础 ===== */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4f3 0%, #e8f5f0 50%, #f0f7f4 100%);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

/* ===== 聊天容器 ===== */
.chat-container {
  flex: 1;
  box-sizing: border-box;
}

.chat-list {
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 120rpx 24rpx;
  box-sizing: border-box;
}

/* ===== 装饰背景 - 柔和光晕 ===== */
.decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  opacity: 0.5;
  box-sizing: border-box;
}

.decoration-1 {
  top: -100rpx;
  left: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.15) 0%, transparent 70%);
  animation: float 12s ease-in-out infinite;
  box-sizing: border-box;
}

.decoration-2 {
  top: 10%;
  right: -150rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(168, 213, 204, 0.15) 0%, transparent 70%);
  animation: float 15s ease-in-out infinite reverse;
  box-sizing: border-box;
}

.decoration-3 {
  bottom: 20%;
  left: -80rpx;
  width: 350rpx;
  height: 350rpx;
  background: radial-gradient(circle, rgba(255, 181, 169, 0.08) 0%, transparent 70%);
  animation: float 18s ease-in-out infinite;
  box-sizing: border-box;
}

@keyframes float {
  0%,
  100% {
    transform: translate(0, 0) scale(1);
    box-sizing: border-box;
  }
  33% {
    transform: translate(20rpx, -25rpx) scale(1.03);
    box-sizing: border-box;
  }
  66% {
    transform: translate(-15rpx, 15rpx) scale(0.97);
    box-sizing: border-box;
  }
}

/* ===== 欢迎卡片 ===== */
.welcome-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  gap: 28rpx;
  animation: fadeIn 0.6s ease-out;
  box-sizing: border-box;
}

.welcome-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8ec5b9 0%, #6f9a8e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 40rpx rgba(142, 197, 185, 0.4);
  position: relative;
  box-sizing: border-box;
}

.welcome-avatar::before {
  content: '';
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.3), transparent);
  animation: avatarGlow 3s ease-in-out infinite;
  box-sizing: border-box;
}

@keyframes avatarGlow {
  0%,
  100% {
    opacity: 0.6;
    transform: scale(1);
    box-sizing: border-box;
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
    box-sizing: border-box;
  }
}

.welcome-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: center;
  box-sizing: border-box;
}

.welcome-bubble {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  padding: 18rpx 32rpx;
  border-radius: 28rpx;
  box-shadow: 0 3rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.welcome-bubble:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.welcome-text {
  font-size: 28rpx;
  color: #4a4a4a;
  line-height: 1.6;
  white-space: pre-wrap;
  letter-spacing: 0.5rpx;
  box-sizing: border-box;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
    box-sizing: border-box;
  }
  to {
    opacity: 1;
    transform: translateY(0);
    box-sizing: border-box;
  }
}

/* ===== 消息布局 ===== */
.message {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 24rpx;
  animation: messageIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing: border-box;
}

.message-bot {
  /* 机器人消息：头像在左，气泡在右 - 正常顺序 */
  box-sizing: border-box;
}

.message-user {
  /* 用户消息：头像在右，气泡在左 - 反转顺序 */
  flex-direction: row-reverse;
  box-sizing: border-box;
}

.message-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  max-width: calc(100% - 84rpx);
  box-sizing: border-box;
}

/* 用户消息：反转后，内容靠右对齐 */
.message-user .message-content {
  align-items: flex-end;
  box-sizing: border-box;
}

.message-user .bubble-time {
  text-align: right;
  box-sizing: border-box;
}

@keyframes messageIn {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.95);
    box-sizing: border-box;
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    box-sizing: border-box;
  }
}

/* ===== 头像样式 ===== */
.avatar {
  flex-shrink: 0;
  margin-bottom: 8rpx;
  box-sizing: border-box;
}

.avatar-inner {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.avatar-img {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.bot-gradient {
  background: linear-gradient(135deg, #8ec5b9 0%, #6f9a8e 100%);
  box-sizing: border-box;
}

.user-gradient {
  background: linear-gradient(135deg, #ffb5a9 0%, #e89585 100%);
  box-sizing: border-box;
}

/* ===== 消息气泡 ===== */
.message-bubble {
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.message-bubble-bot {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-top-left-radius: 8rpx;
}

.message-bubble-user {
  background: linear-gradient(135deg, #8ec5b9 0%, #7bc4a8 100%);
  border-top-right-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(142, 197, 185, 0.3);
}

.bubble-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333333;
  word-break: break-all;
  white-space: pre-wrap;
  letter-spacing: 0.3rpx;
  box-sizing: border-box;
}

.message-bubble-user .bubble-text {
  color: #ffffff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

/* 消息时间 */
.bubble-time {
  font-size: 22rpx;
  color: #bbbbbb;
  padding: 0 4rpx;
  box-sizing: border-box;
}

/* ===== 加载动画 ===== */
.message-bubble.loading {
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.typing-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8ec5b9 0%, #6f9a8e 100%);
  animation: typing 1.4s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  box-sizing: border-box;
}

.typing-dot-2 {
  animation-delay: 0.2s;
  box-sizing: border-box;
}

.typing-dot-3 {
  animation-delay: 0.4s;
  box-sizing: border-box;
}

@keyframes typing {
  0%,
  60%,
  100% {
    transform: translateY(0) scale(1);
    opacity: 0.5;
    box-sizing: border-box;
  }
  30% {
    transform: translateY(-14rpx) scale(1.1);
    opacity: 1;
    box-sizing: border-box;
  }
}

/* ===== 底部占位 ===== */
.bottom-spacer {
  height: 12rpx;
  box-sizing: border-box;
}

/* ===== 输入区域 ===== */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(240, 244, 243, 0.95) 0%, transparent 100%);
  z-index: 100;
  box-sizing: border-box;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 52rpx;
  padding: 14rpx 18rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06), inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing: border-box;
}

.input-wrapper:focus-within {
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 6rpx 32rpx rgba(0, 0, 0, 0.1), inset 0 0 0 1rpx rgba(142, 197, 185, 0.2);
  box-sizing: border-box;
}

.chat-input {
  flex: 1;
  max-height: 240rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #333333;
  padding: 10rpx 14rpx;
  min-height: 44rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: #cccccc;
  font-size: 30rpx;
  box-sizing: border-box;
}

.send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  flex-shrink: 0;
  box-sizing: border-box;
}

.send-btn-hover {
  transform: scale(0.9);
  box-sizing: border-box;
}

.send-btn.active {
  background: linear-gradient(135deg, #8ec5b9 0%, #6f9a8e 100%);
  box-shadow: 0 6rpx 20rpx rgba(142, 197, 185, 0.35);
  transform: scale(1);
  box-sizing: border-box;
}

.send-btn.active:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 12rpx rgba(142, 197, 185, 0.25);
  box-sizing: border-box;
}

/* ===== 响应式适配 ===== */
@media (min-width: 768px) {
  .chat-container {
    max-width: 700rpx;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .message-content {
    max-width: 60%;
    box-sizing: border-box;
  }
}

/* ===== 特殊效果 ===== */
/* 消息进入时的淡入效果 */
.message-enter {
  animation: messageEnter 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing: border-box;
}

/* 停止动画类 - 用于减少不必要的动画 */
.no-animation {
  animation: none !important;
  box-sizing: border-box;
}
