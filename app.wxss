/* app.wxss - 全局样式优化 */
@import './styles/theme.wxss';
@import './static/iconfont/iconfont.wxss';

/* ===== 设计令牌（已在 theme.wxss 中定义）===== */
/* 使用全局主题令牌，保持一致性 */

/* ===== 全局重置 ===== */
page {
  height: 100%;
  font-family: var(--font-family, -apple-system-font, "Helvetica Neue", Helvetica, sans-serif);
  font-size: var(--font-size-base);
  color: var(--text-primary);
  background-color: var(--bg-gradient-start);
  line-height: var(--line-height-normal);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

view, text, image, button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

button {
  border: none;
  outline: none;
  background: none;
  border-radius: 0;
}

button::after {
  border: none;
}

/* ===== 通用工具类 ===== */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: var(--space-6, 24rpx);
}

/* 卡片样式 */
.card {
  background: var(--surface-white);
  border-radius: var(--radius-lg);
  padding: var(--space-6, 24rpx);
  box-shadow: var(--shadow-md);
}

/* 按钮基础样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-3, 12rpx) var(--space-6, 24rpx);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
  min-height: 88rpx; /* WCAG 触摸目标 */
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
  color: var(--surface-white);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--surface-hover);
  color: var(--text-secondary);
}

.btn-ghost {
  background: transparent;
  border: 2rpx solid var(--border-light);
  color: var(--text-primary);
}

/* 文字工具类 */
.text-center {
  text-align: center;
}

.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-light {
  color: var(--text-tertiary);
}

/* Flex 工具类 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ===== 动画关键帧 ===== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.05);
    opacity: 0.8;
  }
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.3);
    opacity: 1;
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 动画类 ===== */
.animate-fade-in {
  animation: fadeIn var(--transition-slow, 300ms) ease-out;
}

.animate-scale-in {
  animation: scaleIn var(--transition-base, 200ms) ease-out;
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}

/* ===== 加载状态 ===== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-12, 48rpx);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border-light);
  border-top-color: var(--primary-start);
  border-radius: var(--radius-full);
  animation: spin 1s linear infinite;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-12, 48rpx);
  color: var(--text-secondary);
}

.empty-state-icon {
  font-size: 96rpx;
  margin-bottom: var(--space-4, 16rpx);
  opacity: 0.5;
}

.empty-state-text {
  font-size: var(--font-size-base);
  color: var(--text-secondary);
}
