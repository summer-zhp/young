/* pages/toolkit/image2pdf/image2pdf.wxss */
@import '../../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  position: relative;
}

.bg-decoration {
  position: fixed;
  top: -150rpx;
  right: -150rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(142, 197, 185, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.content {
  position: relative;
  z-index: 1;
  padding: 32rpx 24rpx;
}

/* 头部说明 */
.header-section {
  margin-bottom: 32rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 32rpx;
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.header-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 上传区域 */
.upload-section {
  margin-bottom: 32rpx;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  border: 2rpx dashed rgba(142, 197, 185, 0.5);
  gap: 16rpx;
  transition: all 0.2s;
}

.upload-area:active {
  background: #f5f7f8;
  border-color: rgba(142, 197, 185, 0.8);
}

.upload-icon {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  border-radius: 50%;
}

.upload-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.upload-hint {
  font-size: 24rpx;
  color: var(--text-disabled);
}

/* 图片列表 */
.image-list {
  margin-top: 24rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.image-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: #f0f0f0;
}

.image-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.image-index {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

/* 转换按钮 */
.convert-section {
  margin-bottom: 32rpx;
}

.convert-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #8ec5b9 0%, #6f9a8e 100%);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(142, 197, 185, 0.4);
  transition: all 0.2s;
}

.convert-btn:active {
  transform: scale(0.98);
}

.convert-btn[disabled] {
  background: #cccccc;
  box-shadow: none;
}

/* 结果区域 */
.result-section {
  margin-bottom: 32rpx;
}

.result-card {
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.result-header-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.result-actions {
  display: flex;
  gap: 16rpx;
}

.result-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, rgba(142, 197, 185, 0.15) 0%, rgba(111, 169, 154, 0.08) 100%);
  border-radius: var(--radius-lg);
}

.result-btn text {
  font-size: 22rpx;
  color: var(--primary-dark);
}

.result-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 20rpx;
  border-top: 1px solid #f0f0f0;
}

.result-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
}
