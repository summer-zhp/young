<!--pages/toolkit/qrcode-generator/qrcode-generator.wxml-->
<view class="page">
  <!-- 装饰背景 -->
  <view class="decoration decoration-1"></view>
  <view class="decoration decoration-2"></view>
  <view class="decoration decoration-3"></view>

  <!-- 头部区域 -->
  <view class="header">
    <view class="header-content">
      <view class="title-badge">
        <t-icon name="scan" size="40rpx" color="#6f9a8e"></t-icon>
        <text class="title-text">二维码生成器</text>
      </view>
      <text class="header-subtitle">输入内容，一键生成精美二维码</text>
    </view>
  </view>

  <!-- 主内容区域 -->
  <view class="main-content">
    <!-- 输入卡片 -->
    <view class="input-card">
      <view class="input-header">
        <t-icon name="edit-1" size="32rpx" color="#8EC5B9"></t-icon>
        <text class="input-label">输入内容</text>
      </view>
      <textarea
        class="input-textarea"
        placeholder="请输入要生成二维码的内容，例如：网址链接、文本信息、联系方式等..."
        maxlength="500"
        value="{{inputText}}"
        bindinput="onInput"
        auto-height
        fixed-height
        cursor-spacing="20"
      />
      <view class="char-count {{charCount > 400 ? 'warning' : ''}}">
        <text class="count">{{charCount}}</text>
        <text class="limit">/500</text>
      </view>
    </view>

    <!-- 样式选择卡片 -->
    <view class="style-card">
      <view class="style-header">
        <t-icon name="palette" size="32rpx" color="#8EC5B9"></t-icon>
        <text class="style-label">二维码颜色</text>
      </view>
      <view class="color-options">
        <view
          class="color-option {{selectedColor === 'dark' ? 'active' : ''}}"
          data-color="dark"
          bindtap="selectColor"
        >
          <view class="color-preview dark-preview"></view>
          <text class="color-name">经典黑</text>
        </view>
        <view
          class="color-option {{selectedColor === 'primary' ? 'active' : ''}}"
          data-color="primary"
          bindtap="selectColor"
        >
          <view class="color-preview primary-preview"></view>
          <text class="color-name">治愈青</text>
        </view>
        <view
          class="color-option {{selectedColor === 'blue' ? 'active' : ''}}"
          data-color="blue"
          bindtap="selectColor"
        >
          <view class="color-preview blue-preview"></view>
          <text class="color-name">深海蓝</text>
        </view>
        <view
          class="color-option {{selectedColor === 'pink' ? 'active' : ''}}"
          data-color="pink"
          bindtap="selectColor"
        >
          <view class="color-preview pink-preview"></view>
          <text class="color-name">珊瑚粉</text>
        </view>
      </view>
    </view>

    <!-- 生成按钮 -->
    <view class="generate-section">
      <button
        class="generate-btn {{hasText ? 'active' : ''}}"
        bindtap="generateQRCode"
        disabled="{{!hasText}}"
      >
        <t-icon name="magic" size="40rpx" color="#FFFFFF"></t-icon>
        <text class="generate-btn-text">{{isGenerating ? '生成中...' : '生成二维码'}}</text>
      </button>
    </view>

    <!-- 结果展示 -->
    <view class="result-card" wx:if="{{qrCodeImage}}">
      <view class="result-header">
        <view class="result-title">
          <t-icon name="check-circle" size="36rpx" color="#52c41a"></t-icon>
          <text>生成成功</text>
        </view>
        <view class="result-actions">
          <view class="action-btn" bindtap="previewImage">
            <t-icon name="image-1" size="32rpx" color="#8EC5B9"></t-icon>
            <text>预览</text>
          </view>
          <view class="action-btn" bindtap="saveImage">
            <t-icon name="download" size="32rpx" color="#8EC5B9"></t-icon>
            <text>保存</text>
          </view>
        </view>
      </view>
      <view class="qr-code-wrapper">
        <view class="qr-code-border">
          <image class="qr-code-image" src="{{qrCodeImage}}" mode="aspectFit" />
        </view>
      </view>
      <view class="qr-code-tip">
        <t-icon name="info-circle" size="28rpx" color="#999999"></t-icon>
        <text>长按图片可保存，也可分享到朋友圈</text>
      </view>
    </view>
  </view>

  <!-- 隐藏的 Canvas 用于生成二维码 -->
  <canvas type="2d" id="hiddenQrcodeCanvas" class="hidden-canvas" />
</view>
