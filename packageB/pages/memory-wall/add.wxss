/* packageB/pages/memory-wall/add.wxss */
@import '../../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== 表单区域 ===== */
.form {
  padding: 24rpx 32rpx;
}

.section {
  background: var(--surface-white);
  border-radius: var(--radius-xl);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-xs);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.section-title-text {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
  flex: 1;
}

.section-title-hint {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

/* ===== 图片网格 ===== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx;
  z-index: 2;
}

.image-add {
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--border-normal);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all var(--transition-base);
}

.image-add:active {
  background: var(--surface-hover);
  border-color: var(--primary-start);
}

.image-add-text {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* ===== 文字输入 ===== */
.textarea-wrap {
  position: relative;
}

.text-input {
  width: 100%;
  font-size: var(--font-size-base);
  color: var(--text-primary);
  line-height: var(--line-height-relaxed);
  padding: 16rpx 0;
  box-sizing: border-box;
}

.text-count {
  display: block;
  text-align: right;
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* ===== 位置区域 ===== */
.location-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.location-info {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.location-detail {
  flex: 1;
  min-width: 0;
}

.location-name {
  font-size: var(--font-size-base);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-address {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
}

.location-placeholder {
  flex: 1;
}

.location-placeholder-text {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

/* ===== 保存按钮 ===== */
.save-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, transparent 0%, rgba(245, 247, 248, 0.95) 30%);
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  border-radius: var(--radius-full);
  padding: 28rpx 0;
  box-shadow: var(--shadow-primary);
  transition: all var(--transition-base);
}

.save-btn:active {
  transform: scale(0.97);
}

.save-btn.disabled {
  opacity: 0.6;
}

.save-btn-text {
  font-size: var(--font-size-lg);
  color: #fff;
  font-weight: var(--font-weight-semibold);
}
