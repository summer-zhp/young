/* packageB/pages/memory-wall/index.wxss */
@import '../../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7f8 0%, #e8f5f3 100%);
  position: relative;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 0 64rpx;
}

.empty-icon {
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-bottom: 48rpx;
}

.empty-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  padding: 20rpx 48rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-primary);
}

.empty-btn:active {
  transform: scale(0.96);
}

.empty-btn-text {
  font-size: var(--font-size-base);
  color: #fff;
  font-weight: var(--font-weight-semibold);
}

/* ===== 纪念墙头部 ===== */
.wall-scroll {
  height: 100vh;
}

.wall-header {
  padding: 24rpx 32rpx 8rpx;
}

.wall-count {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

/* ===== 双列网格 ===== */
.wall-grid {
  display: flex;
  padding: 0 20rpx;
  gap: 16rpx;
}

.wall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ===== 纪念卡片 ===== */
.memory-card {
  background: var(--surface-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base);
  opacity: 0;
  animation: cardFadeIn 0.4s ease-out forwards;
}

.memory-card:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-xs);
}

@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 图片区域 */
.card-image-wrap {
  position: relative;
  width: 100%;
}

.card-image {
  width: 100%;
  height: 320rpx;
  display: block;
}

.image-count {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(0, 0, 0, 0.5);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

.image-count-text {
  font-size: 20rpx;
  color: #fff;
}

/* 文字内容 */
.card-content {
  padding: 16rpx 20rpx 0;
}

.card-text {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  line-height: var(--line-height-normal);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 底部信息 */
.card-footer {
  padding: 12rpx 20rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-location {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.card-location-text {
  font-size: 20rpx;
  color: var(--primary-start);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-time {
  font-size: 20rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  gap: 12rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--border-light);
  border-top-color: var(--primary-start);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.load-more-text {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.bottom-space {
  height: 160rpx;
}

/* ===== 悬浮添加按钮 ===== */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-start) 0%, var(--primary-end) 100%);
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(142, 197, 185, 0.5);
  z-index: 100;
  transition: all var(--transition-base);
}

.fab-btn:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(142, 197, 185, 0.4);
}

/* ===== 详情弹窗 ===== */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.detail-container {
  position: relative;
  width: 90%;
  max-height: 80vh;
  background: var(--surface-white);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.detail-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  z-index: 10;
}

.detail-swiper {
  width: 100%;
  height: 500rpx;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-content {
  padding: 28rpx 32rpx 0;
}

.detail-text {
  font-size: var(--font-size-base);
  color: var(--text-primary);
  line-height: var(--line-height-relaxed);
}

.detail-info {
  padding: 20rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-location {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.detail-location-text {
  font-size: var(--font-size-sm);
  color: var(--primary-start);
  flex: 1;
}

.detail-time {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.detail-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 32rpx 36rpx;
}

.detail-delete:active {
  opacity: 0.7;
}

.detail-delete-text {
  font-size: var(--font-size-sm);
  color: var(--error);
}
